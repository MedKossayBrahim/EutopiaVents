<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" style="-fx-padding: 15;" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.esprit.controllers.ChatController"
      prefHeight="350"
      minHeight="350"
      maxHeight="350">
    <VBox.margin>
        <Insets top="20"/>
    </VBox.margin>
    
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Event Assistant" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <ImageView fitHeight="20" fitWidth="20">
            <Image url="@Images/search_icon.jpg"/>
        </ImageView>
    </HBox>
    
    <ScrollPane fx:id="scrollPane" VBox.vgrow="ALWAYS" 
                style="-fx-background-color: transparent; 
                       -fx-background: transparent;
                       -fx-border-color: #E8E8E8;
                       -fx-border-radius: 10;
                       -fx-background-radius: 10;"
                hbarPolicy="NEVER">
        <style>
            .scroll-pane {
                -fx-background-color: transparent;
                -fx-padding: 0;
            }
            .scroll-pane > .viewport {
                -fx-background-color: transparent;
            }
            .scroll-pane .scroll-bar:vertical {
                -fx-background-color: transparent;
                -fx-pref-width: 10;
                -fx-padding: 0 2;
            }
            .scroll-pane .scroll-bar:vertical .thumb {
                -fx-background-color: #FFE5EC;
                -fx-background-radius: 10;
                -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 0);
            }
            .scroll-pane .scroll-bar:vertical .thumb:hover {
                -fx-background-color: #FFD6E1;
            }
            .scroll-pane .scroll-bar:vertical .thumb:pressed {
                -fx-background-color: #FFC7D6;
            }
            .scroll-pane .scroll-bar:vertical .track {
                -fx-background-color: transparent;
            }
            .scroll-pane .scroll-bar:vertical .increment-button,
            .scroll-pane .scroll-bar:vertical .decrement-button {
                -fx-background-color: transparent;
                -fx-padding: 0;
                -fx-pref-height: 0;
            }
            .scroll-pane .corner {
                -fx-background-color: transparent;
            }
        </style>
        <VBox fx:id="chatArea" spacing="10" 
              style="-fx-padding: 10;
                     -fx-background-color: white;
                     -fx-background-radius: 10;"/>
    </ScrollPane>
    
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="userInput" HBox.hgrow="ALWAYS" 
                  promptText="Ask about events..."
                  onAction="#handleSend"
                  style="-fx-background-radius: 20;
                         -fx-padding: 8 15;
                         -fx-border-color: #E8E8E8;
                         -fx-border-radius: 20;
                         -fx-background-color: white;"/>
        <Button text="Send" onAction="#handleSend"
                style="-fx-background-color: #FFE5EC;
                       -fx-text-fill: #333333; 
                       -fx-background-radius: 20;
                       -fx-padding: 8 20;
                       -fx-font-size: 13;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>
    </HBox>
</VBox> 