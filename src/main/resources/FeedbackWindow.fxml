<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" prefWidth="400" prefHeight="300">
    <VBox spacing="10" alignment="CENTER" layoutX="50" layoutY="30">
        <Label text="Donnez votre avis" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TextArea fx:id="feedbackTextArea" prefWidth="300" prefHeight="100" wrapText="true" />

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnEnvoyer" text="Envoyer" />
            <Button fx:id="btnAnnuler" text="Annuler" />
        </HBox>
    </VBox>
</AnchorPane>
