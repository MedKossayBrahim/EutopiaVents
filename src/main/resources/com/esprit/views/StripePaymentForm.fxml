<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.StripePaymentController"
            prefHeight="400.0" prefWidth="500.0" styleClass="payment-form">
    
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #4285F4; -fx-padding: 15px;">
            <Label text="Paiement Sécurisé" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>
            <HBox alignment="CENTER" spacing="10">
                <ImageView fitHeight="30.0" fitWidth="50.0" preserveRatio="true">
                    <Image url="@../images/stripe-logo.png"/>
                </ImageView>
                <ImageView fitHeight="30.0" fitWidth="40.0" preserveRatio="true">
                    <Image url="@../images/lock-icon.png"/>
                </ImageView>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 20px;">
            <Label fx:id="amountLabel" text="Montant total: 0.00 EUR" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            
            <Separator/>
            
            <Label text="Informations de la carte" style="-fx-font-weight: bold;"/>
            
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="90" prefWidth="120"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200" prefWidth="250"/>
                </columnConstraints>
                
                <Label text="Titulaire:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="cardholderField" promptText="Nom du titulaire" 
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                
                <Label text="Numéro de carte:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="cardNumberField" promptText="1234 5678 9012 3456" 
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                
                <Label text="Date d'expiration:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <ComboBox fx:id="expiryMonthCombo" prefWidth="80"/>
                    <ComboBox fx:id="expiryYearCombo" prefWidth="100"/>
                </HBox>
                
                <Label text="Code CVV:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="cvvField" promptText="123" maxWidth="80"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>
            
            <Separator/>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <CheckBox fx:id="saveCardCheckbox" text="Sauvegarder ma carte pour les futurs paiements"/>
            </HBox>
            
            <HBox alignment="CENTER" spacing="10">
                <ImageView fitHeight="25.0" fitWidth="40.0" preserveRatio="true">
                    <Image url="@../images/visa.png"/>
                </ImageView>
                <ImageView fitHeight="25.0" fitWidth="40.0" preserveRatio="true">
                    <Image url="@../images/mastercard.png"/>
                </ImageView>
                <ImageView fitHeight="25.0" fitWidth="40.0" preserveRatio="true">
                    <Image url="@../images/amex.png"/>
                </ImageView>
            </HBox>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20px; -fx-background-color: #f1f1f1;">
            <Button fx:id="cancelButton" text="Annuler" prefWidth="120"
                    style="-fx-background-color: #e0e0e0;"/>
            <Button fx:id="payButton" text="Payer" prefWidth="120" defaultButton="true"
                    style="-fx-background-color: #4285F4; -fx-text-fill: white;"/>
        </HBox>
    </bottom>
    
</BorderPane> 