<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml" 
            fx:controller="com.esprit.controllers.PostViewController"
            style="-fx-background-color: #faf6f3;">
            
    <left>
        <fx:include source="Navbar.fxml"/>
    </left>
    
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #faf6f3;">
            <VBox spacing="20" style="-fx-padding: 30;">
                <VBox style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);">
                    <HBox style="-fx-background-color: #f0eae4; 
                                -fx-background-radius: 12; 
                                -fx-padding: 15 20;
                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 1);
                                -fx-margin-bottom: 20;">
                        <Label fx:id="postTitleLabel" text="POST TITLE" 
                               style="-fx-font-family: 'Segoe UI'; 
                                      -fx-font-size: 28px; 
                                      -fx-font-weight: bold; 
                                      -fx-text-fill: #2D3250;"/>
                    </HBox>
                    
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 20 0;">
                        <Label text="Published By: " style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #666; -fx-font-size: 13px;"/>
                        <Label fx:id="authorLabel" text="Username" style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #424874; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="On: " style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #666; -fx-font-size: 13px;"/>
                        <Label fx:id="dateLabel" text="15/01/2025" style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #424874; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    </HBox>
                    
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="deletePostButton" visible="false"/>
                    </HBox>
                    
                    <TextFlow fx:id="contentFlow" style="-fx-padding: 20 0;">
                        <Text fx:id="contentText" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-fill: #333; -fx-line-spacing: 1.5;"/>
                    </TextFlow>
                    
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 20 0;">
                        <Button fx:id="likeButton" text="♡"
                                style="-fx-font-size: 22px; -fx-background-color: transparent; -fx-text-fill: #424874; -fx-cursor: hand;"/>
                        <Label fx:id="likesCount" text="500 likes" 
                               style="-fx-font-family: 'Segoe UI'; -fx-text-fill: #666; -fx-font-size: 13px;"/>
                    </HBox>
                    
                    <VBox spacing="15" style="-fx-padding: 20 0;">
                        <Label text="Comments" 
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2D3250;"/>
                        
                        <VBox fx:id="commentsContainer" spacing="15" 
                              style="-fx-background-color: #f0eae4; 
                                     -fx-background-radius: 15; 
                                     -fx-padding: 20; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"/>
                        
                        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                            <com.esprit.components.AutocompleteTextField fx:id="commentField" 
                                    HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane> 