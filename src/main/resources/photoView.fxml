<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.photo"
            prefHeight="700.0" prefWidth="1200.0"
            stylesheets="@styles/photo.css">

    <left>
        <fx:include source="Navbar.fxml"/>
    </left>
    
    <center>
        <VBox spacing="20">
            <padding>
                <Insets topRightBottomLeft="20"/>
            </padding>

            <!-- Header Section -->
            <Label text="Gestion des Photos des Lieux" styleClass="header-label"/>

            <!-- Form Section -->
            <GridPane hgap="15" vgap="15">
                <padding><Insets topRightBottomLeft="10"/></padding>

                <Label text="Lieu associé:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboBoxLieux" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1" onAction="#afficherPhotosPourLieu"/>

                <Label text="Chemin de l'image:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="txtUrlImage" prefWidth="300" editable="false"/>
                    <Button text="Parcourir" onAction="#choisirImage" styleClass="browse-button"/>
                </HBox>
            </GridPane>

            <!-- Preview Section -->
            <VBox spacing="10" styleClass="preview-box">
                <Label text="Aperçu de l'image"/>
                <ImageView fx:id="imagePreview" fitHeight="180" fitWidth="280" preserveRatio="true"/>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="Ajouter" onAction="#ajouterPhoto" styleClass="action-button"/>
                <Button text="Modifier" onAction="#modifierPhoto" styleClass="action-button"/>
                <Button text="Supprimer" onAction="#supprimerPhoto" styleClass="delete-button"/>
                <Button text="Réinitialiser" onAction="#clearFields" styleClass="reset-button"/>
            </HBox>

            <!-- Gallery Section -->
            <VBox spacing="10">
                <Label text="Galerie des Photos"/>
                <FlowPane fx:id="flowPanePhotos" hgap="15" vgap="15" prefWrapLength="750"/>
            </VBox>
        </VBox>
    </center>
    <Button fx:id="btnGoToReservation" text="Aller à la réservation" onAction="#goToReservation"
            AnchorPane.bottomAnchor="10.0"
            AnchorPane.leftAnchor="10.0"
            AnchorPane.rightAnchor="10.0"
            prefHeight="30.0"
            styleClass="button-bottom"/>
    <Button fx:id="btnGoToLieu" text="← Retour" onAction="#goToLieu"
            AnchorPane.topAnchor="10.0"
            AnchorPane.rightAnchor="10.0"
            styleClass="button-back"/>
</BorderPane>