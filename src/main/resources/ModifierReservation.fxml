<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.ModifierReservationController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Modifier la réservation" style="-fx-font-size: 20px;"/>
    
    <GridPane vgap="10" hgap="10">
        <Label text="ID Événement:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="evenementIdField" editable="false" 
                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="ID Matériel:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="materielIdField" editable="false" 
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Quantité:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="quantiteField" 
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label text="Prix Total:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="prixTotalLabel" 
               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Date Début:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <DatePicker fx:id="dateDebutPicker" disable="true"
                    GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Date Fin:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <DatePicker fx:id="dateFinPicker" disable="true"
                    GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    
    <HBox spacing="10" alignment="CENTER">
        <Button text="Sauvegarder" onAction="#handleSauvegarder"/>
        <Button text="Annuler" onAction="#handleAnnuler"/>
    </HBox>
</VBox> 