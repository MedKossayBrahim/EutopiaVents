<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.Listeproduit"
      styleClass="main-container"
      stylesheets="@styles/listeproduit.css">

    <!-- Main Content -->
    <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff;">
        <!-- En-tête -->
        <HBox styleClass="header-container" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label styleClass="main-title" text="EutopiaVents Store"/>
        </HBox>

        <!-- Buttons Section -->
        <HBox alignment="CENTER" spacing="15" styleClass="action-buttons-container">
            <padding>
                <Insets top="5" right="20" bottom="15" left="20"/>
            </padding>
            
            <!-- Ajouter Catégorie Button -->
            <Button fx:id="btnAjoutCategorie"
                    text="Ajouter Catégorie"
                    onAction="#openAjoutCategorie"
                    styleClass="action-button">
                <graphic>
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@Images/categoriesIcon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            
            <!-- Liste Catégorie Button -->
            <Button fx:id="btnListeCategorie"
                    text="Liste Catégories"
                    onAction="#openListeCategorie"
                    styleClass="action-button">
                <graphic>
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@Images/list.png"/>
                    </ImageView>
                </graphic>
            </Button>
            
            <!-- Ajouter Produit Button -->
            <Button fx:id="btnAjoutProduit"
                    text="Ajouter Produit"
                    onAction="#openAjoutProduit"
                    styleClass="action-button">
                <graphic>
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@Images/tshirt.png"/>
                    </ImageView>
                </graphic>
            </Button>
            
            <!-- Panier Button -->
            <Button fx:id="btnListeCommande"
                    text="Panier"
                    onAction="#openListeCommande"
                    styleClass="action-button">
                <graphic>
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@Images/panierproduit.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Barre de recherche et filtres -->
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 20;">
            <TextField fx:id="searchField" promptText="Rechercher un produit..."
                       styleClass="search-field"
                       prefWidth="300"/>
            <ComboBox fx:id="priceFilter" promptText="Filtrer par prix"
                      styleClass="combo-box"/>
            <Button fx:id="ajouterAuPanierBtn" text="Ajouter au Panier"
                    styleClass="button-primary"/>
        </HBox>

        <!-- Contenu scrollable -->
        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="content-area"
                    style="-fx-background-color: transparent;">
            <VBox spacing="15" alignment="CENTER">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <GridPane fx:id="produitsGrid"
                          vgap="20"
                          hgap="20"
                          alignment="CENTER"
                          styleClass="produits-grid">
                    <!-- Les produits seront ajoutés ici dynamiquement -->
                </GridPane>

                <Pagination fx:id="pagination"
                            styleClass="custom-pagination"
                            maxPageIndicatorCount="5"/>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>