<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.GererEvenementsController"
            stylesheets="@eventsstyle.css"
            style="-fx-background-color: #faf6f3;">

    <left>
        <VBox style="-fx-background-color: #faf6f3; -fx-border-color: transparent #dedad7 transparent transparent; -fx-border-width: 0 1px 0 0;"
              BorderPane.alignment="TOP_LEFT"
              VBox.vgrow="ALWAYS">
            <fx:include source="Navbar.fxml"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-padding: 30;">
            <Label text="Gérer Événements" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- Barre de navigation en haut -->
            <HBox spacing="20" alignment="CENTER" style="-fx-background-color: white; 
                  -fx-background-radius: 15; -fx-padding: 20; 
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <Button fx:id="btnAjouterCateg" text="Ajouter Catégorie"
                        onAction="#goToAjouterCateg"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                <Button fx:id="btnAjouterEvenement" text="Ajouter Événement"
                        onAction="#goToAjouterEvenement"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                <Button fx:id="btnModifierEvenement" text="Modifier Événement"
                        onAction="#goToModifierEvenement"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                <Button fx:id="btnGererEvenements" text="Gérer Événements"
                        onAction="#goToGererEvenements"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>
            </HBox>

            <!-- Card pour le filtrage -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; 
                 -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                <Label text="Événements en attente d'approbation" 
                      style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <Label text="Ces événements ont besoin de votre validation avant de pouvoir être publiés."
                      style="-fx-font-size: 14; -fx-text-fill: #6c757d;"/>
            </VBox>

            <!-- Table avec style moderne -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 15; 
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                <TableView fx:id="eventTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="titreColumn" text="Titre" style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14;"/>
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200" style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14;"/>
                        <TableColumn fx:id="dateDebutColumn" text="Date début" prefWidth="110" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="dateFinColumn" text="Date fin" prefWidth="110" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="capaciteColumn" text="Capacité" prefWidth="80" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="categorieIdColumn" text="Catégorie" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="lieuColumn" text="Lieu" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="organisateurColumn" text="Organisateur" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="prixColumn" text="Prix" prefWidth="80" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                    </columns>
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                </TableView>
            </VBox>
            
            <!-- Boutons bas de page -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Actualiser" onAction="#refreshTable"
                       style="-fx-background-color: #6c757d; -fx-text-fill: white; 
                              -fx-font-weight: bold; -fx-padding: 10 20; 
                              -fx-background-radius: 8; -fx-font-size: 14;"/>
                              
                <Button text="Retour" onAction="#goToEventsView"
                       style="-fx-background-color: #17a2b8; -fx-text-fill: white; 
                              -fx-font-weight: bold; -fx-padding: 10 20; 
                              -fx-background-radius: 8; -fx-font-size: 14;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
