<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<ScrollPane stylesheets="@styleskossay.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.NewPassView">
    <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="700.0">
        <Pane prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: #F5D0C8;">
            <ImageView fitHeight="259.0" fitWidth="207.0" layoutX="64.0" layoutY="71.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@images/eutopia2.png" />
            </ImageView>
        </Pane>
        <TextField fx:id="newPass" layoutX="50.0" layoutY="150.0" promptText="Mot de passe" AnchorPane.leftAnchor="350.0" AnchorPane.rightAnchor="50.0" />
        <Button layoutX="50.0" layoutY="266.0" mnemonicParsing="false" onAction="#passUpdate" prefHeight="42.0" prefWidth="300.0" text="Continuer" AnchorPane.leftAnchor="350.0" AnchorPane.rightAnchor="50.0">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Text layoutX="50.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nouveau Mot de passe" AnchorPane.leftAnchor="350.0" />
        <Group layoutX="350.3999938964844" layoutY="47.05078125"
               onMouseClicked="#back">
            <children>
                <Text layoutX="14.0" layoutY="13.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Back" wrappingWidth="42.09222412109375" />
                <ImageView fitHeight="35.0" fitWidth="15.0" layoutY="0.94921875" pickOnBounds="true" preserveRatio="true">
                    <Image url="@icons/back.png" />
                </ImageView>
            </children>
        </Group>
        <TextField fx:id="confNewPass" layoutX="49.0" layoutY="209.0" promptText="Confirmer Mot de passe" AnchorPane.leftAnchor="350.0" AnchorPane.rightAnchor="50.0" />
    </AnchorPane>
</ScrollPane>
