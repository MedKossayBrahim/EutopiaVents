<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<ScrollPane stylesheets="@styleskossay.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.OtpView">
    <content>
        <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="700.0">
            <Pane prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: #F5D0C8;">
                <ImageView fitHeight="259.0" fitWidth="207.0" layoutX="64.0" layoutY="71.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@images/eutopia2.png" />
                </ImageView>
            </Pane>
            <TextField fx:id="email" layoutX="50.0" layoutY="200.0" promptText="Email" AnchorPane.leftAnchor="350.0" AnchorPane.rightAnchor="50.799999999999955" />
            <Button fx:id="submit" onAction="#toEnterOTP" layoutX="50.0" layoutY="266.0" mnemonicParsing="false" prefHeight="42.0" prefWidth="300.0" text="Send OTP" AnchorPane.leftAnchor="350.0" AnchorPane.rightAnchor="50.799999999999955">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>
            <Text fx:id="welcome" layoutX="50.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Forgot Password" AnchorPane.leftAnchor="350.0" />
            <Text layoutX="50.0" layoutY="159.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Enter your phone number. we’ll send you a code to reset your password." wrappingWidth="299.20000000000005" AnchorPane.leftAnchor="350.0" />
            <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="324.8" layoutY="203.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="324.8">
                <Image url="@icons/mail.png" />
            </ImageView>
            <Group layoutX="350.3999938964844" layoutY="47.05078125" AnchorPane.leftAnchor="350.0"
                   fx:id="back" onMouseClicked="#back">
                <children>
                    <Text layoutX="19.0" layoutY="13.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Back" />
                    <ImageView fitHeight="35.0" fitWidth="15.0" layoutY="0.94921875" pickOnBounds="true" preserveRatio="true">
                        <Image url="@icons/back.png" />
                    </ImageView>
                </children>
            </Group>
        </AnchorPane>
    </content>
</ScrollPane>
