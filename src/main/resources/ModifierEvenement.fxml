<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.ModifierEvenementController"
            stylesheets="@eventsstyle.css"
            style="-fx-background-color: #faf6f3;">

    <left>
        <VBox style="-fx-background-color: #faf6f3; -fx-border-color: transparent #dedad7 transparent transparent; -fx-border-width: 0 1px 0 0;"
              BorderPane.alignment="TOP_LEFT"
              VBox.vgrow="ALWAYS">
            <fx:include source="Navbar.fxml"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-padding: 30;">
            <Label text="Modifier Événements" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- Message pour aucun événement -->
            <Label fx:id="noEventsLabel"
                   text="Aucun événement trouvé pour cet organisateur"
                   style="-fx-font-size: 16; -fx-text-fill: #dc3545; -fx-background-color: #f8d7da; -fx-padding: 15; -fx-background-radius: 8;"
                   visible="false"/>

            <!-- Barre de navigation en haut -->
            <HBox spacing="20" alignment="CENTER" style="-fx-background-color: white; 
                  -fx-background-radius: 15; -fx-padding: 20; 
                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <Button fx:id="btnAjouterCateg" text="Ajouter Catégorie"
                        onAction="#goToAjouterCateg"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                <Button fx:id="btnAjouterEvenement" text="Ajouter Événement"
                        onAction="#goToAjouterEvenement"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                <Button fx:id="btnModifierEvenement" text="Modifier Événement"
                        onAction="#goToModifierEvenement"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                <Button fx:id="btnGererEvenements" text="Gérer Événements"
                        onAction="#goToGererEvenements"
                        style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                               -fx-background-radius: 8px; -fx-padding: 12px 24px;
                               -fx-font-size: 14px; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>
            </HBox>

            <!-- Card pour le filtrage -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; 
                 -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                <Label text="Vos événements" 
                      style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <Label text="Double-cliquez sur un champ pour le modifier. Cliquez sur le bouton Modifier pour enregistrer vos changements."
                      style="-fx-font-size: 14; -fx-text-fill: #6c757d;"/>
            </VBox>

            <!-- Table avec style moderne -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
                    <TableView fx:id="eventTable" editable="true" style="-fx-background-color: transparent;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="titreColumn" text="Titre" prefWidth="150" style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14;"/>
                            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200" style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14;"/>
                            <TableColumn fx:id="categorieColumn" text="Catégorie" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                            <TableColumn fx:id="dateDebutColumn" text="Date début" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                            <TableColumn fx:id="dateFinColumn" text="Date fin" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                            <TableColumn fx:id="capaciteColumn" text="Capacité" prefWidth="80" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                            <TableColumn fx:id="prixColumn" text="Prix" prefWidth="80" style="-fx-alignment: CENTER-RIGHT; -fx-font-size: 14;"/>
                            <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-size: 14;"/>
                        </columns>
                        <VBox.margin>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </VBox.margin>
                    </TableView>
                </ScrollPane>
            </VBox>

            <!-- Guide d'utilisation -->
            <VBox spacing="10" style="-fx-background-color: #e9f7fe; -fx-background-radius: 12; -fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Conseils d'utilisation" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #17a2b8;"/>
                </HBox>
                <Label text="• Double-cliquez sur un champ pour le modifier" style="-fx-font-size: 14; -fx-text-fill: #5c7080;"/>
                <Label text="• Vous ne pouvez modifier que vos propres événements" style="-fx-font-size: 14; -fx-text-fill: #5c7080;"/>
                <Label text="• Le statut ne peut être changé qu'en 'annulé'" style="-fx-font-size: 14; -fx-text-fill: #5c7080;"/>
            </VBox>

            <!-- Boutons bas de page -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Retour" onAction="#handleRetour"
                       style="-fx-background-color: #007bff; -fx-text-fill: white; 
                              -fx-font-weight: bold; -fx-padding: 12 25; 
                              -fx-background-radius: 8; -fx-font-size: 14;
                              -fx-effect: dropshadow(three-pass-box, rgba(0,123,255,0.3), 5, 0, 0, 0);"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
