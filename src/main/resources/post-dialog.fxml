<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.esprit.controllers.PostDialogController"
      spacing="20"
      style="-fx-background-color: #faf6f3;
             -fx-padding: 25;
             -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.25), 10, 0, 0, 4);
             -fx-background-radius: 15;
             -fx-border-color: rgba(245,148,92,0.1);
             -fx-border-radius: 15;
             -fx-border-width: 1;">

    <!-- Title -->
    <Label text="New Post" 
           style="-fx-font-size: 28px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #f5945c;
                  -fx-font-family: 'Segoe UI';
                  -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.2), 2, 0, 0, 1);"/>

    <!-- AI Assistant Section -->
    <VBox spacing="10" style="-fx-padding: 15; 
                              -fx-background-color: linear-gradient(to right, #f0eae4, #f5e6d3); 
                              -fx-background-radius: 12;
                              -fx-border-color: rgba(245,148,92,0.1);
                              -fx-border-radius: 12;
                              -fx-border-width: 1;
                              -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.15), 5, 0, 0, 2);">
        <CheckBox fx:id="eventor" 
                  text="Use Eventor AI Assistant"
                  style="-fx-text-fill: #2D3250;
                         -fx-font-size: 14px;
                         -fx-font-family: 'Segoe UI';"/>
        
        <TextArea fx:id="promptArea" 
                  wrapText="true"
                  prefRowCount="2"
                  promptText="Describe the post you want to create..."
                  disable="true"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(245,148,92,0.2);
                         -fx-border-radius: 10;
                         -fx-border-width: 1;
                         -fx-padding: 12;
                         -fx-font-size: 14px;
                         -fx-font-family: 'Segoe UI';
                         -fx-prompt-text-fill: #888888;
                         -fx-focus-color: #f5945c;
                         -fx-faint-focus-color: rgba(245,148,92,0.2);"/>
        
        <Button fx:id="generateButton" 
                text="Generate Content"
                disable="true"
                style="-fx-background-color: linear-gradient(to right, #f5945c, #f0ad4e);
                       -fx-text-fill: white;
                       -fx-background-radius: 10;
                       -fx-padding: 10 20;
                       -fx-font-size: 14px;
                       -fx-font-family: 'Segoe UI';
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.4), 6, 0, 0, 2);"/>
    </VBox>

    <!-- Title Field -->
    <TextField fx:id="titleField" 
              promptText="Post Title"
              style="-fx-background-color: #f0eae4;
                     -fx-background-radius: 10;
                     -fx-border-color: rgba(245,148,92,0.2);
                     -fx-border-radius: 10;
                     -fx-border-width: 1;
                     -fx-padding: 12;
                     -fx-font-size: 14px;
                     -fx-font-family: 'Segoe UI';
                     -fx-prompt-text-fill: #888888;
                     -fx-text-fill: #2D3250;
                     -fx-focus-color: #f5945c;
                     -fx-faint-focus-color: rgba(245,148,92,0.2);"/>

    <!-- Content Area -->
    <TextArea fx:id="contentArea" 
              wrapText="true"
              prefRowCount="8"
              promptText="Post Content"
              style="-fx-background-color: #f0eae4;
                     -fx-background-radius: 10;
                     -fx-border-color: rgba(245,148,92,0.2);
                     -fx-border-radius: 10;
                     -fx-border-width: 1;
                     -fx-padding: 12;
                     -fx-font-size: 14px;
                     -fx-font-family: 'Segoe UI';
                     -fx-prompt-text-fill: #888888;
                     -fx-text-fill: #2D3250;
                     -fx-focus-color: #f5945c;
                     -fx-faint-focus-color: rgba(245,148,92,0.2);"/>

    <!-- Category Selection -->
    <ComboBox fx:id="categoryComboBox" 
              editable="true"
              promptText="Select or type new category"
              style="-fx-background-color: #f0eae4 !important;
                     -fx-background-radius: 10 !important;
                     -fx-border-color: rgba(245,148,92,0.2) !important;
                     -fx-border-radius: 10 !important;
                     -fx-border-width: 1 !important;
                     -fx-padding: 2 !important;
                     -fx-font-size: 14px !important;
                     -fx-font-family: 'Segoe UI' !important;
                     -fx-prompt-text-fill: #888888 !important;
                     -fx-text-fill: #2D3250 !important;
                     -fx-focus-color: #f5945c !important;
                     -fx-faint-focus-color: rgba(245,148,92,0.2) !important;
                     -fx-focus-traversable: false !important;"
              maxWidth="300">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
    </ComboBox>

    <!-- Pin Option -->
    <CheckBox fx:id="pinnedCheckBox" 
              text="Pin this post"
              style="-fx-text-fill: #2D3250;
                     -fx-font-size: 14px;
                     -fx-font-family: 'Segoe UI';"/>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" 
                text="Cancel"
                style="-fx-background-color: rgba(245,148,92,0.1);
                       -fx-text-fill: #f5945c;
                       -fx-border-color: rgba(245,148,92,0.2);
                       -fx-border-radius: 10;
                       -fx-background-radius: 10;
                       -fx-padding: 10 20;
                       -fx-font-size: 14px;
                       -fx-font-family: 'Segoe UI';
                       -fx-cursor: hand;"/>
        <Button fx:id="saveButton" 
                text="Post"
                defaultButton="true"
                style="-fx-background-color: linear-gradient(to right, #f5945c, #f0ad4e);
                       -fx-text-fill: white;
                       -fx-background-radius: 10;
                       -fx-padding: 10 20;
                       -fx-font-size: 14px;
                       -fx-font-family: 'Segoe UI';
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.4), 6, 0, 0, 2);"/>
    </HBox>
</VBox> 