<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="20" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.ListeMaterielController"
      style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Liste des Matériels"
           style="-fx-font-size: 28px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #2c3e50;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);"/>

    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0;">
        <TextField fx:id="searchField" promptText="Rechercher un matériel..."
                   style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-font-size: 14px;
                         -fx-padding: 10 20;
                         -fx-prompt-text-fill: #95a5a6;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                   prefWidth="300"/>

        <ComboBox fx:id="categorieComboBox" promptText="Sélectionner une catégorie"
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-font-size: 14px;
                         -fx-padding: 10 20;
                         -fx-prompt-text-fill: #95a5a6;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                  prefWidth="200"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Ajouter un Matériel" onAction="#ajouterMateriel"
                style="-fx-background-color: #3498db;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 20;
                       -fx-padding: 10 25;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.3), 10, 0, 0, 2);"/>
    </HBox>

    <TableView fx:id="materielTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;
                      -fx-background-radius: 15;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">
        <columns>
            <TableColumn fx:id="libelleColumn" text="Libellé" prefWidth="200"
                         style="-fx-alignment: CENTER-LEFT; -fx-font-size: 13px;"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"
                         style="-fx-alignment: CENTER-LEFT; -fx-font-size: 13px;"/>
            <TableColumn fx:id="quantiteColumn" text="Quantité" prefWidth="100"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn fx:id="prixColumn" text="Prix" prefWidth="100"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn fx:id="categorieColumn" text="Catégorie" prefWidth="150"
                         style="-fx-alignment: CENTER-LEFT; -fx-font-size: 13px;"/>
            <TableColumn fx:id="imageUrlColumn" text="Image URL" prefWidth="200"
                         style="-fx-alignment: CENTER-LEFT; -fx-font-size: 13px;"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
        </columns>
    </TableView>

    <stylesheets>
        <URL value="@/stylemateriel.css"/>
    </stylesheets>
</VBox>