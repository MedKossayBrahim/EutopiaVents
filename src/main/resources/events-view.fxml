<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.EventsController"
      style="-fx-background-color: white;">

    <!-- En-tête avec titre et filtres si nécessaire -->
    <VBox style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
        <Label text="Événements à venir" 
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Zone principale de défilement -->
    <ScrollPane fx:id="scrollPane" 
                fitToWidth="true" 
                style="-fx-background-color: transparent;">
        <content>
            <VBox style="-fx-padding: 20;">
                <GridPane fx:id="eventsGrid" 
                         hgap="20" 
                         vgap="20" 
                         style="-fx-padding: 10;">
                    <!-- Les événements seront ajoutés ici dynamiquement -->
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </GridPane>
            </VBox>
        </content>
    </ScrollPane>

</VBox>
