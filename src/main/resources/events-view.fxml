<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>


<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<?import javafx.geometry.Insets?>
<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.EventsController"
            style="-fx-background-color: #faf6f3;">

    <left>
        <VBox style="-fx-background-color: #faf6f3; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 4, 0);">
            <fx:include source="Navbar.fxml"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="24" style="-fx-padding: 32;">
                <!-- Header Section with Cart Icon -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Text text="Découvrez nos événements"
                              style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
                        <Text text="Explorez et participez à des événements passionnants"
                              style="-fx-font-size: 16px; -fx-fill: #6c757d;"/>
                    </VBox>
                    <ImageView fx:id="cartIcon" onMouseClicked="#goToPanier"
                               fitHeight="30" fitWidth="30"
                               style="-fx-cursor: hand;">
                        <Image url="@/icons/carts.png"/>
                    </ImageView>
                </HBox>

                <!-- Navigation Bar -->
                <VBox fx:id="navigationBox" alignment="CENTER"
                      style="-fx-background-color: white;
                             -fx-background-radius: 20px;
                             -fx-padding: 20px;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                    <HBox spacing="20" alignment="CENTER">
                        <Button fx:id="btnAjouterCateg" text="Ajouter Catégorie"
                                onAction="#goToAjouterCateg"
                                style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                                       -fx-background-radius: 8px; -fx-padding: 12px 24px;
                                       -fx-font-size: 14px; -fx-cursor: hand;
                                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                        <Button fx:id="btnAjouterEvenement" text="Ajouter Événement"
                                onAction="#goToAjouterEvenement"
                                style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                                       -fx-background-radius: 8px; -fx-padding: 12px 24px;
                                       -fx-font-size: 14px; -fx-cursor: hand;
                                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                        <Button fx:id="btnModifierEvenement" text="Modifier Événement"
                                onAction="#goToModifierEvenement"
                                style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                                       -fx-background-radius: 8px; -fx-padding: 12px 24px;
                                       -fx-font-size: 14px; -fx-cursor: hand;
                                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>

                        <Button fx:id="btnGererEvenements" text="Gérer Événements"
                                onAction="#goToGererEvenements"
                                style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
                                       -fx-background-radius: 8px; -fx-padding: 12px 24px;
                                       -fx-font-size: 14px; -fx-cursor: hand;
                                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"/>


                        <Button fx:id="btnReviews" mnemonicParsing="false" onAction="#goToReviews"
                                style="-fx-background-color: #b0a8a0; -fx-text-fill: white;
               -fx-background-radius: 8px; -fx-padding: 12px 24px;
               -fx-font-size: 14px; -fx-cursor: hand;
               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 2);"
                                text="Mes avis">
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                            <padding>
                                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                            </padding>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Search and Filter Bar -->
                <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                    <TextField fx:id="searchField" promptText="Rechercher un événement..."
                               style="-fx-pref-height: 40; -fx-background-radius: 8; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-padding: 8;"
                               HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="categoryFilter" promptText="Filtrer par catégorie"
                              style="-fx-pref-height: 40; -fx-background-radius: 8; -fx-border-color: #dee2e6; -fx-border-radius: 8;"/>
                </HBox>

                <!-- Events Grid in a white container -->
                <VBox spacing="16" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                    <GridPane fx:id="eventsGrid" hgap="20" vgap="20"/>
                    <Pagination fx:id="eventsPagination"
                                style="-fx-page-information-visible: false;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

