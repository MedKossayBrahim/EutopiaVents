<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.StatistiqueController">

    <VBox spacing="20" alignment="CENTER" prefWidth="1000" prefHeight="800" style="-fx-padding: 20;">
        
        <!-- Graphique des périodes de pointe des réservations -->
        <Label text="Périodes de Pointe des Réservations" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <LineChart fx:id="lineChartSaisons" title="Réservations par Mois" 
                  prefHeight="250" prefWidth="900">
            <xAxis>
                <CategoryAxis label="Mois" />
            </xAxis>
            <yAxis>
                <NumberAxis label="Nombre de Réservations" />
            </yAxis>
        </LineChart>

        <!-- Graphique des revenus mensuels -->
        <Label text="Revenus Mensuels" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <LineChart fx:id="lineChartRevenues" title="Revenus par Mois" 
                  prefHeight="250" prefWidth="900">
            <xAxis>
                <CategoryAxis label="Mois" />
            </xAxis>
            <yAxis>
                <NumberAxis label="Revenus (TND)" />
            </yAxis>
        </LineChart>

        <!-- Tableau des revenus mensuels -->
        <TableView fx:id="tableRevenues" prefHeight="200" prefWidth="900">
            <columns>
                <TableColumn fx:id="colMois" text="Mois" prefWidth="450"/>
                <TableColumn fx:id="colRevenu" text="Revenu (TND)" prefWidth="450"/>
            </columns>
        </TableView>

        <!-- Label pour le revenu total -->
        <Label fx:id="lblTotalRevenue" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    </VBox>
</AnchorPane>