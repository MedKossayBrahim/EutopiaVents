<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.StatistiqueController">

    <VBox spacing="20" alignment="CENTER" prefWidth="800" prefHeight="600" style="-fx-padding: 20;">

        <!-- Graphique et Tableau des Matériels les plus utilisés -->
        <Label text="Top 10 Matériels les plus utilisés" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <HBox spacing="20" alignment="CENTER">
            <BarChart fx:id="barChartMateriels" title="Matériels les plus utilisés" prefHeight="300" prefWidth="400">
                <xAxis>
                    <CategoryAxis fx:id="xAxisMateriels" label="Matériel" />
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="yAxisMateriels" label="Nombre d'utilisations" />
                </yAxis>
            </BarChart>
            <TableView fx:id="tableMateriels" prefWidth="350" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colNomMateriel" text="Matériel" prefWidth="175" />
                    <TableColumn fx:id="colNombreUtilisation" text="Utilisation" prefWidth="175" />
                </columns>
            </TableView>
        </HBox>

        <!-- Graphique des périodes de pointe des réservations -->
        <Label text="Périodes de Pointe des Réservations" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <LineChart fx:id="lineChartSaisons" title="Périodes de Pointe des Réservations" prefHeight="300" prefWidth="600">
            <xAxis>
                <CategoryAxis fx:id="xAxisSaisons" label="Mois" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxisSaisons" label="Nombre de Réservations" />
            </yAxis>
        </LineChart>
    </VBox>
</AnchorPane>