<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.EventDetailsController"
      stylesheets="@styles.css"
      spacing="20"
      style="-fx-padding: 20; -fx-background-color: -main-bg;">

    <!-- Titre de l'événement -->
    <Label fx:id="titreLabel" styleClass="title-label" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Lieu, Date, Horaires alignés horizontalement -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox spacing="5">
            <Label text="Lieu" style="-fx-font-weight: bold; -fx-text-fill: -text;"/>
            <Label fx:id="lieuLabel" style="-fx-text-fill: -text;"/>

        </VBox>
        <VBox spacing="5">
            <Label text="Date" style="-fx-font-weight: bold; -fx-text-fill: -text;"/>
            <Label fx:id="dateLabel" style="-fx-text-fill: -text;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Horaires" style="-fx-font-weight: bold; -fx-text-fill: -text;"/>
            <Label fx:id="timeLabel" style="-fx-text-fill: -text;"/>
        </VBox>
    </HBox>

    <!-- Image de l'événement -->
    <ImageView fx:id="eventImageView"
               fitWidth="400"
               fitHeight="250"
               preserveRatio="true"
               styleClass="card"/>

    <!-- Description de l'événement -->
    <Label fx:id="descriptionLabel" style="-fx-font-size: 14px; -fx-text-fill: -text;"/>

    <!-- Durée -->


    <!-- Bouton de réservation -->
    <Button fx:id="reserverButton"
            onAction="#reserverEvenement"
            text="Réserver"
            styleClass="confirm-button"/>
</VBox>
