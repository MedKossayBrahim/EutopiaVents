<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.ListeReservationController"
            styleClass="root"
            style="-fx-background-color: linear-gradient(to bottom right, #f0f4f8, #d9e2ec);">

    <center>
        <VBox spacing="25" alignment="CENTER">
            <padding>
                <Insets top="35" right="45" bottom="35" left="45"/>
            </padding>

            <!-- En-tête avec dégradé -->
            <HBox styleClass="header" alignment="CENTER"
                  style="-fx-background-radius: 18; 
                         -fx-background-color: linear-gradient(to right, #3498db, #2980b9); 
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 4);">
                <padding>
                    <Insets top="25" right="30" bottom="25" left="30"/>
                </padding>
                <VBox alignment="CENTER">
                    <Label text="Liste des Réservations" 
                           style="-fx-font-size: 32px; 
                                  -fx-font-weight: bold; 
                                  -fx-text-fill: white;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 0, 1);"/>
                    <Label text="Gérez les réservations de matériels" 
                           style="-fx-font-size: 16px; 
                                  -fx-text-fill: #e6f2ff;
                                  -fx-font-style: italic;"/>
                </VBox>
            </HBox>

            <!-- Zone de filtrage avec design moderne -->
            <HBox spacing="20" alignment="CENTER" 
                  style="-fx-background-radius: 18; 
                         -fx-background-color: white; 
                         -fx-padding: 20; 
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 2);">
                <TextField fx:id="filterEventField" promptText="Filtrer par événement..."
                           style="-fx-background-color: #f0f4f8;
                                  -fx-background-radius: 25;
                                  -fx-border-radius: 25;
                                  -fx-font-size: 14px;
                                  -fx-padding: 12 25;
                                  -fx-prompt-text-fill: #829ab1;
                                  -fx-effect: innershadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);"
                           prefWidth="220"/>

                <TextField fx:id="filterMaterialField" promptText="Filtrer par matériel..."
                           style="-fx-background-color: #f0f4f8;
                                  -fx-background-radius: 25;
                                  -fx-border-radius: 25;
                                  -fx-font-size: 14px;
                                  -fx-padding: 12 25;
                                  -fx-prompt-text-fill: #829ab1;
                                  -fx-effect: innershadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);"
                           prefWidth="220"/>

                <TextField fx:id="filterUserField" promptText="Filtrer par utilisateur..."
                           style="-fx-background-color: #f0f4f8;
                                  -fx-background-radius: 25;
                                  -fx-border-radius: 25;
                                  -fx-font-size: 14px;
                                  -fx-padding: 12 25;
                                  -fx-prompt-text-fill: #829ab1;
                                  -fx-effect: innershadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);"
                           prefWidth="220"/>
            </HBox>

            <!-- Tableau des réservations -->
            <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS" 
                       style="-fx-background-color: white;
                              -fx-background-radius: 18;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 4);
                              -fx-border-color: #e6f2ff;
                              -fx-border-width: 1;
                              -fx-border-radius: 18;">
                <columns>
                    <TableColumn fx:id="userColumn" text="Utilisateur" prefWidth="120"
                                 style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14px;"/>
                    <TableColumn fx:id="evenementIdColumn" text="Événement" prefWidth="100"
                                 style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14px;"/>
                    <TableColumn fx:id="materielIdColumn" text="Matériel" prefWidth="100"
                                 style="-fx-alignment: CENTER-LEFT; -fx-font-size: 14px;"/>
                    <TableColumn fx:id="quantiteColumn" text="Quantité" prefWidth="80"
                                 style="-fx-alignment: CENTER; -fx-font-size: 14px;"/>
                    <TableColumn fx:id="prixTotalColumn" text="Prix Total" prefWidth="100"
                                 style="-fx-alignment: CENTER; -fx-font-size: 14px;"/>
                    <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="120"
                                 style="-fx-alignment: CENTER; -fx-font-size: 14px;"/>
                    <TableColumn fx:id="dateFinColumn" text="Date Fin" prefWidth="120"
                                 style="-fx-alignment: CENTER; -fx-font-size: 14px;"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"
                                 style="-fx-alignment: CENTER; -fx-font-size: 14px;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <stylesheets>
        <URL value="@/stylereservation.css"/>
    </stylesheets>
</BorderPane>