<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.ListeReservationController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Text title="Feedback" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <Label text="Liste des Réservations" style="-fx-font-size: 20px;"/>

    <!-- Zone de filtrage -->
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="filterEventField" promptText="Filtrer par événement..." style="-fx-background-color: white; -fx-border-radius: 5px; -fx-padding: 5px;" maxWidth="200" prefWidth="200"/>
        <TextField fx:id="filterMaterialField" promptText="Filtrer par matériel..." style="-fx-background-color: white; -fx-border-radius: 5px; -fx-padding: 5px;" maxWidth="200" prefWidth="200"/>
        <TextField fx:id="filterUserField" promptText="Filtrer par utilisateur..." style="-fx-background-color: white; -fx-border-radius: 5px; -fx-padding: 5px;" maxWidth="200" prefWidth="200"/>
    </HBox>

    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="userColumn" text="Utilisateur" prefWidth="120"/>
            <TableColumn fx:id="evenementIdColumn" text="Événement" prefWidth="100"/>
            <TableColumn fx:id="materielIdColumn" text="Matériel" prefWidth="100"/>
            <TableColumn fx:id="quantiteColumn" text="Quantité" prefWidth="80"/>
            <TableColumn fx:id="prixTotalColumn" text="Prix Total" prefWidth="100"/>
            <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="120"/>
            <TableColumn fx:id="dateFinColumn" text="Date Fin" prefWidth="120"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
        </columns>
    </TableView>

    <Label fx:id="materielLabel" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    
    <TextArea fx:id="newFeedbackArea" 
              promptText="Écrivez votre avis ici..."
              wrapText="true"
              prefRowCount="5"
              style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #f9f9f9;"/>
              
    <Button fx:id="submitButton" 
            text="Ajouter un avis"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14;"
            onMouseEntered="this.setStyle('-fx-background-color: #45a049; -fx-text-fill: white;')"
            onMouseExited="this.setStyle('-fx-background-color: #4CAF50; -fx-text-fill: white;')"/>
    
    <Separator style="-fx-pref-height: 2; -fx-background-color: #cccccc;"/>
    
    <ScrollPane>
        <ListView fx:id="feedbackListView" VBox.vgrow="ALWAYS" style="-fx-pref-height: 200;"/>
    </ScrollPane>
</VBox>