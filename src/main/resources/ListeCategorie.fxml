<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.ListeCategorieController"
      style="-fx-background-color: #eef1f6; -fx-padding: 30px;">

    <Label text="Liste des Catégories" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <TableView fx:id="categorieTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="200" style="-fx-alignment: CENTER-LEFT;"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
