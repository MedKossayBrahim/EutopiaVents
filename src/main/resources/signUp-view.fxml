<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<HBox xmlns="http://javafx.com/javafx/23.0.1" stylesheets="styleskossay.css" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.SignUpView">
    <Pane prefHeight="600.0" prefWidth="450.0" style="-fx-background-color: #F5D0C8;">
        <ImageView fitHeight="259.0" fitWidth="207.0" layoutX="140.0" layoutY="171.0" pickOnBounds="true"
                   preserveRatio="true">
            <Image url="@Images/eutopia2.png"/>
        </ImageView>
    </Pane>
    <Pane prefHeight="600.0" prefWidth="600.0">
        <Text fx:id="welcome" layoutX="283.0" layoutY="74.0" strokeType="OUTSIDE" strokeWidth="0.0"
              text="Bienvenue"/>
        <TextField id="nom" fx:id="nom" layoutX="60.0" layoutY="98.0" prefHeight="50.0" prefWidth="500.0"
                   promptText="Full Name">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </TextField>
        <TextField fx:id="userName" layoutX="60.0" layoutY="178.0" prefHeight="50.0" prefWidth="500.0"
                   promptText="UserName">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </TextField>
        <TextField id="email" fx:id="email" layoutX="60.0" layoutY="250.0" prefHeight="50.0" prefWidth="500.0"
                   promptText="Email"/>
        <TextField id="telephone" fx:id="tel" layoutX="60.0" layoutY="324.0" prefHeight="50.0" prefWidth="500.0"
                   promptText="Telephone">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </TextField>
        <TextField id="password" fx:id="passwd" layoutX="60.0" layoutY="394.0" prefHeight="50.0"
                   prefWidth="500.0" promptText="Mot de passe">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </TextField>
        <Button id="register" fx:id="submit" layoutX="60.0" layoutY="503.0" mnemonicParsing="false"
                onAction="#signUp" prefHeight="50.0" prefWidth="500.0" text="Continuer">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
        </Button>
        <Text fx:id="login" layoutX="60.0" layoutY="470.0" onMouseClicked="#login" strokeType="OUTSIDE"
              strokeWidth="0.0" text="You have an account? Login Here"/>
        <Group fx:id="back" layoutX="65.0" layoutY="61.0" onMouseClicked="#back">
            <Text layoutX="19.0" layoutY="13.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Back"/>
            <ImageView fitHeight="35.0" fitWidth="15.0" layoutY="0.94921875" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@icons/back.png"/>
            </ImageView>
        </Group>
    </Pane>
</HBox>
