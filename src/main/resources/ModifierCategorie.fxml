<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.ModifierCategorieController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Modifier la catégorie" style="-fx-font-size: 20px;"/>
    
    <GridPane vgap="10" hgap="10">
        <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
    </GridPane>
    
    <HBox spacing="10" alignment="CENTER">
        <Button text="Sauvegarder" onAction="#handleSauvegarder"/>
        <Button text="Annuler" onAction="#handleAnnuler"/>
    </HBox>
</VBox> 