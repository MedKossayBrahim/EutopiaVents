<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<StackPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/23.0.1" stylesheets="styleskossay.css"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.EnterOPTView">
    <HBox>
        <Pane prefHeight="600.0" prefWidth="450.0" style="-fx-background-color: #F5D0C8;">
            <ImageView fitHeight="259.0" fitWidth="207.0" layoutX="114.0" layoutY="171.0" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@Images/eutopia2.png"/>
            </ImageView>
        </Pane>
        <Pane prefHeight="600.0" prefWidth="600.0">
            <Group fx:id="back" layoutX="60.0" layoutY="73.0" onMouseClicked="#back">
                <Text layoutX="15.0" layoutY="13.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Back"/>
                <ImageView fitHeight="150.0" fitWidth="15.0" layoutY="0.94921875" pickOnBounds="true"
                           preserveRatio="true">
                    <Image url="@icons/back.png"/>
                </ImageView>
            </Group>
            <Text layoutX="60.0" layoutY="172.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Enter OTP"/>
            <TextField fx:id="input1" layoutX="60.0" layoutY="250.0" maxHeight="-Infinity" maxWidth="-Infinity"
                       minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="50.0"/>
            <TextField fx:id="input2" layoutX="120.0" layoutY="250.0" maxHeight="-Infinity" maxWidth="-Infinity"
                       minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="50.0"/>
            <TextField fx:id="input3" layoutX="180.0" layoutY="250.0" maxHeight="-Infinity" maxWidth="-Infinity"
                       minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="50.0"/>
            <TextField fx:id="input4" layoutX="240.0" layoutY="250.0" maxHeight="-Infinity" maxWidth="-Infinity"
                       minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="50.0"/>
            <TextField fx:id="input5" layoutX="300.0" layoutY="250.0" maxHeight="-Infinity" maxWidth="-Infinity"
                       minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="50.0"/>
            <Button layoutX="60.0" layoutY="389.0" mnemonicParsing="false" onAction="#check" prefHeight="50.0"
                    prefWidth="500.0" text="Verify">
                <font>
                    <Font name="System Bold" size="12.0"/>
                </font>
            </Button>

            <Text layoutX="60.0" layoutY="194.0" strokeType="OUTSIDE" strokeWidth="0.0"
                  text="We have share a code of your registered Phone number">
                <font>
                    <Font name="High Tower Text Italic" size="12.0"/>
                </font>
            </Text>
        </Pane>
    </HBox>
</StackPane>
