<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.paniers">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Mon Panier" style="-fx-font-size: 20px;"/>

    <!-- Section du panier -->
    <VBox spacing="5">
        <TableView fx:id="panierTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="panierProduitColumn" text="Produit" prefWidth="200"/>
                <TableColumn fx:id="panierQuantiteColumn" text="Quantité" prefWidth="100"/>
                <TableColumn fx:id="panierPrixColumn" text="Prix total" prefWidth="100"/>
                <TableColumn fx:id="panierActionsColumn" text="Actions" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Total et bouton de validation -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Total: "/>
            <Label fx:id="totalLabel" style="-fx-font-weight: bold;"/>
            <Button fx:id="validerPanierButton" text="Valider le panier"/>
            <Button fx:id="confirmerSmsButton" text="Confirmer par SMS" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</VBox>