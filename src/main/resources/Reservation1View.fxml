<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane 
    prefHeight="700.0" 
    prefWidth="1200.0"
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.esprit.controllers.Reservation1"
    stylesheets="@styles/theme.css">

    <VBox 
        spacing="20" 
        AnchorPane.topAnchor="0.0" 
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0" 
        AnchorPane.rightAnchor="0.0">

        <!-- En-tête -->
        <HBox styleClass="header-container" alignment="CENTER">
            <Label styleClass="main-title" text="Réservations des éspaces"/>
        </HBox>

        <!-- Contenu principal -->
        <HBox 
            spacing="20" 
            VBox.vgrow="ALWAYS" 
            styleClass="content-container">

            <!-- Panneau gauche : Formulaire -->
            <VBox styleClass="form-container" spacing="15">
                <Label styleClass="section-title" text="Nouvelle Réservation"/>

                <!-- Sélection du lieu -->
                <VBox spacing="5">
                    <Label text="Espace *"/>
                    <ComboBox fx:id="lieuComboBox" prefWidth="300"/>
                    <Label fx:id="lieuCapaciteLabel" styleClass="info-label"/>
                </VBox>

                <!-- Dates de réservation -->
                <VBox spacing="5">
                    <Label text="Date et heure de début *"/>
                    <HBox spacing="10">
                        <DatePicker fx:id="dateDebutPicker"/>
                        <ComboBox fx:id="heureDebutCombo" prefWidth="100"/>
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <Label text="Date et heure de fin *"/>
                    <HBox spacing="10">
                        <DatePicker fx:id="dateFinPicker"/>
                        <ComboBox fx:id="heureFinCombo" prefWidth="100"/>
                    </HBox>
                </VBox>

                <!-- Boutons d'action -->
                <HBox styleClass="buttons-container" spacing="10">
                    <!-- Bouton Réserver pour les utilisateurs non-admin -->
                    <Button 
                        fx:id="reserverBtn" 
                        text="Réserver" 
                        styleClass="button-primary" 
                        onAction="#handleAjouter"/>
                        
                    <!-- Boutons admin -->
                    <VBox fx:id="adminButtonsContainer" spacing="10">
                        <HBox spacing="10">
                            <Button 
                                fx:id="ajouterBtn" 
                                text="Ajouter" 
                                styleClass="button-primary" 
                                onAction="#handleAjouter"/>
                            <Button 
                                fx:id="modifierBtn" 
                                text="Modifier" 
                                styleClass="button-secondary" 
                                onAction="#handleModifier"/>
                        </HBox>
                        <HBox spacing="10">
                            <Button 
                                fx:id="supprimerBtn" 
                                text="Supprimer" 
                                styleClass="button-danger" 
                                onAction="#handleSupprimer"/>
                            <Button 
                                fx:id="annulerBtn" 
                                text="Annuler" 
                                styleClass="button-secondary" 
                                onAction="#handleAnnuler"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Label styleClass="info-label" text="* Champs obligatoires"/>
            </VBox>

            <!-- Panneau droit : Liste des réservations -->
            <VBox styleClass="list-container" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Réservations existantes"/>

                <TableView 
                    fx:id="reservationsTable" 
                    VBox.vgrow="ALWAYS"
                    styleClass="custom-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn 
                            fx:id="lieuColumn" 
                            text="Lieu" 
                            prefWidth="200">
                            <style>
                                -fx-wrap-text: true;
                                -fx-alignment: CENTER-LEFT;
                                -fx-padding: 8px;
                            </style>
                        </TableColumn>
                        <TableColumn 
                            fx:id="dateDebutColumn" 
                            text="Début" 
                            prefWidth="150">
                            <style>
                                -fx-wrap-text: true;
                                -fx-alignment: CENTER-LEFT;
                                -fx-padding: 8px;
                            </style>
                        </TableColumn>
                        <TableColumn 
                            fx:id="dateFinColumn" 
                            text="Fin" 
                            prefWidth="150">
                            <style>
                                -fx-wrap-text: true;
                                -fx-alignment: CENTER-LEFT;
                                -fx-padding: 8px;
                            </style>
                        </TableColumn>
                        <TableColumn 
                            fx:id="typeReservationColumn" 
                            text="Type" 
                            prefWidth="100">
                            <style>
                                -fx-wrap-text: true;
                                -fx-alignment: CENTER-LEFT;
                                -fx-padding: 8px;
                            </style>
                        </TableColumn>
                    </columns>
                    <placeholder>
                        <Label text="Aucune réservation disponible"/>
                    </placeholder>
                    <style>
                        -fx-fixed-cell-size: 40;
                    </style>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>

