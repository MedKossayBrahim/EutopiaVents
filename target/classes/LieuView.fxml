<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="700.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.LieuController"
            stylesheets="@styles/categories.css">

    <left>
        <fx:include source="Navbar.fxml"/>
    </left>
    
    <center>
        <VBox spacing="20">
            <!-- En-tête -->
            <HBox styleClass="header-container" alignment="CENTER">
                <Label styleClass="main-title" text="Gestion des Lieux"/>
            </HBox>

            <!-- Contenu principal -->
            <HBox spacing="20" VBox.vgrow="ALWAYS" styleClass="main-content">
                <padding>
                    <Insets left="20" right="200" bottom="20"/>
                </padding>

                <!-- Section gauche : Formulaire -->
                <VBox spacing="15" styleClass="form-section" HBox.hgrow="NEVER"
                      maxWidth="1000" minWidth="800">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label styleClass="section-title" text="Ajouter/Modifier un lieu"/>

                    <!-- Formulaire -->
                    <GridPane vgap="10" hgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <!-- Nom -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Nom du lieu *" styleClass="field-label"/>
                            <TextField fx:id="tfNom" promptText="Ex: Salle Al Amir"/>
                        </VBox>

                        <!-- Catégorie -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Catégorie *" styleClass="field-label"/>
                            <ComboBox fx:id="cbCategorie" maxWidth="Infinity" promptText="Choisir une catégorie"/>
                        </VBox>

                        <!-- Ville -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Ville *" styleClass="field-label"/>
                            <TextField fx:id="tfVille" promptText="Ex: Tunis"/>
                        </VBox>

                        <!-- Code Postal -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Code Postal *" styleClass="field-label"/>
                            <TextField fx:id="tfCodePostal" promptText="Ex: 2083"/>
                        </VBox>

                        <!-- Capacité -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Capacité *" styleClass="field-label"/>
                            <TextField fx:id="tfCapacite" promptText="Ex: 200"/>
                        </VBox>

                        <!-- Prix -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Prix (DT) *" styleClass="field-label"/>
                            <TextField fx:id="tfPrix" promptText="Ex: 1500"/>
                        </VBox>

                        <!-- Adresse -->
                        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="3">
                            <Label text="Adresse *" styleClass="field-label"/>
                            <TextField fx:id="tfAdresse" promptText="Ex: Rue Charles de Gaulle"/>
                        </VBox>

                        <!-- Image URL -->
                        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="4">
                            <Label text="Image URL" styleClass="field-label"/>
                            <TextField fx:id="tfImage" promptText="http://..."/>
                        </VBox>
                    </GridPane>

                    <!-- Boutons -->
                    <HBox spacing="10" alignment="CENTER" styleClass="buttons-container">
                        <Button fx:id="btnAjouter" text="Ajouter"
                                onAction="#ajouterLieu" styleClass="button-primary"/>
                        <Button fx:id="btnModifier" text="Modifier"
                                onAction="#modifierLieu" styleClass="button-secondary"/>
                        <Button fx:id="btnSupprimer" text="Supprimer"
                                onAction="#supprimerLieu" styleClass="button-danger"/>
                        <Button fx:id="btnAnnuler" text="Annuler"
                                onAction="#annuler" styleClass="button-cancel"/>
                    </HBox>

                    <Label styleClass="required-note" text="* Champs obligatoires"/>
                </VBox>

                <!-- Section droite : Liste des lieux -->
                <VBox spacing="100" styleClass="list-section" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label styleClass="section-title" text="Liste des Lieux"/>

                    <TableView fx:id="lieuxTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="200"/>
                            <TableColumn fx:id="villeColumn" text="Ville" prefWidth="120"/>
                            <TableColumn fx:id="capaciteColumn" text="Capacité" prefWidth="120"/>
                            <TableColumn fx:id="prixColumn" text="Prix (DT)" prefWidth="150"/>
                            <TableColumn fx:id="categorieColumn" text="Catégorie" prefWidth="200"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucun lieu disponible"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <Button fx:id="btnGoToCategorie" text="← Retour" onAction="#goToCategorie"
            AnchorPane.topAnchor="10.0"
            AnchorPane.leftAnchor="10.0"
            styleClass="button-back"/>

    <Button fx:id="btnGoToPhotoView" text="Voir les photos" onAction="#goToPhotoView"
            AnchorPane.bottomAnchor="10.0"
            AnchorPane.leftAnchor="10.0"
            AnchorPane.rightAnchor="10.0"
            prefHeight="30.0"
            styleClass="button-bottom"/>
</BorderPane>