<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.ListeMaterielController"
      style="-fx-background-color: #eef1f6; -fx-padding: 30px;">

    <Label text="Liste des Matériels" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- Zone de recherche et bouton ajout aligné à droite -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Rechercher un matériel..."
                   style="-fx-background-color: white; -fx-border-radius: 5px; -fx-padding: 5px;"
                   maxWidth="300" prefWidth="300"/>

        <Region HBox.hgrow="ALWAYS"/> <!-- Cet élément pousse le bouton vers la droite -->

        <Button text="Ajouter un Matériel" onAction="#ajouterMateriel"
                style="-fx-font-size: 14px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 5px;"/>
    </HBox>

    <TableView fx:id="materielTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-radius: 10px; -fx-background-radius: 10px;
                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <columns>
            <TableColumn fx:id="libelleColumn" text="Libellé" prefWidth="200" style="-fx-alignment: CENTER-LEFT;"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300" style="-fx-alignment: CENTER-LEFT;"/>
            <TableColumn fx:id="quantiteColumn" text="Quantité" prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="prixColumn" text="Prix" prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="categorieColumn" text="Catégorie" prefWidth="150" style="-fx-alignment: CENTER-LEFT;"/>
            <TableColumn fx:id="imageUrlColumn" text="Image URL" prefWidth="200" style="-fx-alignment: CENTER-LEFT;"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>

</VBox>