<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml" fx:controller="com.esprit.controllers.DetailsMaterielController">
    <ImageView fx:id="imageView" fitHeight="200" fitWidth="200" preserveRatio="true"/>
    
    <Label fx:id="libelleLabel" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    <Label fx:id="descriptionLabel" wrapText="true"/>
    <Label fx:id="prixLabel" style="-fx-font-weight: bold;"/>
    <Label fx:id="quantiteDispoLabel"/>
    
    <HBox spacing="10" alignment="CENTER">
        <Label text="Quantité à réserver:"/>
        <Spinner fx:id="quantiteSpinner" prefWidth="100"/>
    </HBox>
    
    <Button fx:id="reserverButton" text="Réserver"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox> 