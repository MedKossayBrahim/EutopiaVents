<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane stylesheets="styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.LoginView">
    <children>
        <HBox stylesheets="@styles.css">
            <children>
                <Pane prefHeight="400.0" prefWidth="450.0" style="-fx-background-color: #F5D0C8;">
                    <ImageView fitHeight="259.0" fitWidth="207.0" layoutX="140.0" layoutY="171.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@images/calendar.png" />
                    </ImageView>
                </Pane>
                <Pane prefHeight="600.0" prefWidth="600.0">
                    <children>
                        <TextField id="email" fx:id="loginEmail" layoutX="91.0" layoutY="182.0" prefHeight="38.0" prefWidth="500.0" promptText="Email" />

                        <PasswordField id="password" fx:id="loginPasswd" layoutX="91.0" layoutY="277.0" prefHeight="38.0" prefWidth="500.0" promptText="Password" />
                        <TextField id="password" fx:id="VloginPasswd" layoutX="92.0" layoutY="277.0" prefHeight="38.0" prefWidth="500.0" promptText="Password" visible="false" />
                        <Button fx:id="login" layoutX="90.0" layoutY="465.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="42.0" prefWidth="500.0" text="Login">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Text fx:id="welcome" layoutX="85.0" layoutY="99.0" text="Welcome">
                            <font>
                                <Font />
                            </font></Text>
                        <Text layoutX="90.0" layoutY="138.0" text="Please login here">
                            <font>
                                <Font size="15.0" />
                            </font></Text>
                        <CheckBox fx:id="rememberMe" layoutX="91.0" layoutY="335.0" prefHeight="17.0" prefWidth="133.0" text="Remember Me" />
                        <Text fx:id="forgotPass" layoutX="91.0" layoutY="400.0" onMouseClicked="#handleForgotPassword" text="Forgot password" />
                        <Text id="signUP" fx:id="signUP" layoutX="416.0" layoutY="348.0" onMouseClicked="#handleSignUp" text="Don't Have an Account?  SignUP" />
                        <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="61.0" layoutY="191.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@images/calendar.png" />
                        </ImageView>
                        <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="61.0" layoutY="286.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@images/calendar.png" />
                        </ImageView>
                        <ImageView fx:id="togglePasswordIcon" fitHeight="20.0" fitWidth="20.0" layoutX="566.0" layoutY="291.0" onMouseClicked="#togglePasswordVisibility" pickOnBounds="true" preserveRatio="true">
                            <Image url="@images/calendar.png" />
                        </ImageView>
                    </children>
                </Pane>
            </children>
        </HBox>
    </children>
</StackPane>