<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<ScrollPane stylesheets="@styleskossay.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.EnterOPTView">
    <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="700.0">
        <Pane prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: #F5D0C8;">
            <ImageView fitHeight="259.0" fitWidth="207.0" layoutX="64.0" layoutY="71.0" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@images/eutopia2.png"/>
            </ImageView>
        </Pane>
        <Text layoutX="65.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Back"
              AnchorPane.leftAnchor="350.0"/>
        <Text layoutX="50.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0"
              text="Enter OTP" AnchorPane.leftAnchor="350.0"/>
        <TextField fx:id="input1" layoutX="49.0" layoutY="180.0" maxHeight="-Infinity" maxWidth="-Infinity"
                   minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="40.0"
                   AnchorPane.leftAnchor="350.0"/>
        <TextField fx:id="input2" layoutX="403.0" layoutY="180.0" maxHeight="-Infinity" maxWidth="-Infinity"
                   minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="40.0"/>
        <TextField fx:id="input3" layoutX="449.0" layoutY="180.0" maxHeight="-Infinity" maxWidth="-Infinity"
                   minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="40.0"/>
        <TextField fx:id="input4" layoutX="497.0" layoutY="180.0" maxHeight="-Infinity" maxWidth="-Infinity"
                   minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="40.0"/>
        <TextField fx:id="input5" layoutX="545.0" layoutY="180.0" maxHeight="-Infinity" maxWidth="-Infinity"
                   minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="40.0"/>
        <Button onAction="#check" layoutX="50.0" layoutY="266.0" mnemonicParsing="false" prefHeight="42.0"
                prefWidth="300.0" text="Verify" AnchorPane.leftAnchor="350.0" AnchorPane.rightAnchor="50.0">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
        </Button>
        <ImageView fitHeight="35.0" fitWidth="15.0" layoutX="50.0" layoutY="48.0" pickOnBounds="true"
                   preserveRatio="true" AnchorPane.leftAnchor="50.0">
            <Image url="@/icons/back.png"/>
        </ImageView>
        <Text layoutX="54.0" layoutY="142.0" strokeType="OUTSIDE" strokeWidth="0.0"
              text="We have share a code of your registered Phone number" AnchorPane.leftAnchor="350.0">
            <font>
                <Font name="High Tower Text Italic" size="12.0"/>
            </font>
        </Text>
    </AnchorPane>
</ScrollPane>
