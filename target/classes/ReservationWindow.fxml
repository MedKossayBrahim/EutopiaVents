<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="20" alignment="CENTER" xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Nouvelle Réservation" styleClass="title-label"/>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Rechercher un matériel:"/>
        <TextField fx:id="searchField" prefWidth="200"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <VBox spacing="5">
            <Label text="Date de début"/>
            <DatePicker fx:id="dateDebutPicker"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Date de fin"/>
            <DatePicker fx:id="dateFinPicker"/>
        </VBox>
    </HBox>

    <TableView fx:id="materielsTable" VBox.vgrow="ALWAYS" editable="true">
        <columns>
            <TableColumn fx:id="selectColumn" text="Sélectionner" prefWidth="100"/>
            <TableColumn fx:id="libelleColumn" text="Libellé" prefWidth="150"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200"/>
            <TableColumn fx:id="prixColumn" text="Prix" prefWidth="100"/>
            <TableColumn fx:id="stockColumn" text="Stock Disponible" prefWidth="120"/>
            <TableColumn fx:id="quantiteColumn" text="Quantité à réserver" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Prix Total:" styleClass="title-label"/>
        <Label fx:id="prixTotalLabel" text="0.00 TND" styleClass="title-label"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="confirmerButton" text="Confirmer la réservation" styleClass="success"/>
        <Button fx:id="annulerButton" text="Annuler" styleClass="danger"/>
    </HBox>

    <stylesheets>
        <URL value="@/styleall.css"/>
    </stylesheets>
</VBox> 