<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.AfficheCategorie"
            stylesheets="@styles/categories.css">
    <children>
        <VBox spacing="20" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <!-- En-tête -->
            <HBox styleClass="header-container" alignment="CENTER">
                <Label styleClass="main-title" text="Détails de la Catégorie"/>
            </HBox>

            <!-- Contenu -->
            <VBox styleClass="details-container" spacing="20">
                <VBox spacing="10">
                    <Label text="Nom de la catégorie"/>
                    <TextField fx:id="tfNom" styleClass="details-field"/>
                </VBox>

                <VBox spacing="10">
                    <Label text="Description"/>
                    <TextField fx:id="tfDescription" styleClass="details-field"/>
                </VBox>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="btnModifier" styleClass="button-primary"
                            onAction="#modifierCategorie" text="Enregistrer les modifications"/>
                    <Button fx:id="btnSupprimer" styleClass="button-danger"
                            onAction="#supprimerCategorie" text="Supprimer"/>
                    <Button styleClass="button-secondary" onAction="#retourAjout" text="Retour à la liste"/>
                </HBox>
            </VBox>
        </VBox>
    </children>

    <Button fx:id="btnGoToLieu" text="Aller à Lieu" onAction="#goToLieu"
            AnchorPane.bottomAnchor="10.0"
            AnchorPane.leftAnchor="10.0"
            AnchorPane.rightAnchor="10.0"
            styleClass="button-bottom"/>


</AnchorPane>