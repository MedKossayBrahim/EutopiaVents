<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/20"
      fx:controller="com.esprit.controllers.ModifierProduit"> <!-- Updated controller reference -->

   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>

   <Label text="Modifier le produit" style="-fx-font-size: 20px;"/>

   <GridPane vgap="10" hgap="10">
      <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
      <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

      <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
      <TextArea fx:id="descriptionArea" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

      <Label text="Stock:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
      <TextField fx:id="stockField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

      <Label text="Catégorie:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
      <ComboBox fx:id="categorieComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

      <Label text="Prix:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
      <TextField fx:id="prixField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

      <Label text="Image:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
      <TextField fx:id="imageUrlField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

      <ImageView fx:id="ImageView" fitHeight="100.0" fitWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
   </GridPane>

   <Button text="Sauvegarder" onAction="#handleSauvegarder"/>
   <Button text="Upload Image" onAction="#handleImageUpload"/>
</VBox>