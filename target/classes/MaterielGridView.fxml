<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.MaterielGridController"
            styleClass="root">

    <center>
        <VBox spacing="20" alignment="CENTER">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <!-- En-tête -->
            <Label text="Liste des Matériels" styleClass="title-label"/>

            <!-- Barre de navigation -->
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnMaterielList" 
                        text="Liste des Matériels" 
                        onAction="#navigateToMaterielList"
                        styleClass="button"/>
                
                <Button fx:id="btnCategoriesList" 
                        text="Liste des Catégories" 
                        onAction="#navigateToCategoriesList"
                        styleClass="button"/>
                
                <Button text="Liste des Réservations"
                        onAction="#openListeReservation"
                        styleClass="button"/>
                
                <Button text="Statistiques"
                        onAction="#openstats"
                        styleClass="button"/>
                
                <Button text="Nouvelle Réservation" 
                        onAction="#openReservationWindow"
                        styleClass="success"/>
            </HBox>

            <!-- Pagination -->
            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="previousButton" 
                        text="Précédent" 
                        onAction="#handlePreviousButtonAction"
                        styleClass="button"/>
                
                <Button fx:id="nextButton" 
                        text="Suivant" 
                        onAction="#handleNextButtonAction"
                        styleClass="button"/>
            </HBox>

            <!-- Grille de matériels -->
            <ScrollPane fitToWidth="true" 
                       fitToHeight="true" 
                       VBox.vgrow="ALWAYS" 
                       styleClass="scroll-pane">
                <StackPane alignment="CENTER">
                    <GridPane fx:id="gridPaneMateriels" 
                             hgap="20" 
                             vgap="20" 
                             alignment="CENTER"/>
                </StackPane>
            </ScrollPane>
        </VBox>
    </center>

    <stylesheets>
        <URL value="@/styleall.css"/>
    </stylesheets>
</BorderPane>