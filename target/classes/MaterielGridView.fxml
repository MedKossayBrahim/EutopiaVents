<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.MaterielGridController">

    <VBox spacing="15" alignment="CENTER" VBox.vgrow="ALWAYS" style="-fx-padding: 20;">


        <!-- Titre -->
        <Label text="Liste des Matériels" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <!-- Boutons de navigation vers d'autres pages -->
        <HBox spacing="20" alignment="CENTER">
            <Button fx:id="btnMaterielList" text="Liste des Matériels" onAction="#navigateToMaterielList" />
            <Button fx:id="btnCategoriesList" text="Liste des Catégories" onAction="#navigateToCategoriesList" />
        </HBox>

        <!-- Boutons de pagination -->
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="previousButton" text="Précédent" onAction="#handlePreviousButtonAction" />
            <Button fx:id="nextButton" text="Suivant" onAction="#handleNextButtonAction" />
        </HBox>
        <!-- ScrollPane pour rendre la grille scrollable -->
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <GridPane fx:id="gridPaneMateriels" hgap="10" vgap="10" alignment="CENTER" style="-fx-background-color: transparent;">
            </GridPane>
        </ScrollPane>


    </VBox>

</AnchorPane>