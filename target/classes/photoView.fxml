<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.photo"
            prefHeight="400.0" prefWidth="600.0">
    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <!-- TableView pour afficher la liste des photos -->
        <TableView fx:id="tablePhotos" prefHeight="200">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colLieuId" text="Lieu ID" prefWidth="100"/>
                <TableColumn fx:id="colUrl" text="URL Image" prefWidth="350"/>
            </columns>
        </TableView>
        <!-- Formulaire pour ajouter/modifier une photo -->
        <HBox spacing="10">
            <Label text="Lieu ID:"/>
            <TextField fx:id="txtLieuId" promptText="Saisir l'ID du lieu" prefWidth="100"/>
            <Label text="URL:"/>
            <TextField fx:id="txtUrlImage" promptText="Saisir l'URL de l'image" prefWidth="250"/>
        </HBox>
        <!-- Boutons d'action -->
        <HBox spacing="10">
            <Button text="Ajouter" onAction="#ajouterPhoto"/>
            <Button text="Modifier" onAction="#modifierPhoto"/>
            <Button text="Supprimer" onAction="#supprimerPhoto"/>
        </HBox>
    </VBox>
</AnchorPane>
