<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import java.net.URL?>

<VBox spacing="20" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.ListeReservationController"
      style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Liste des Réservations" 
           style="-fx-font-size: 28px; 
                  -fx-font-weight: bold;
                  -fx-text-fill: #2c3e50;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 2, 0, 0, 1);"/>

    <!-- Zone de filtrage avec design moderne -->
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0;">
        <TextField fx:id="filterEventField" promptText="Filtrer par événement..."
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-font-size: 14px;
                         -fx-padding: 10 20;
                         -fx-prompt-text-fill: #95a5a6;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                  prefWidth="200"/>

        <TextField fx:id="filterMaterialField" promptText="Filtrer par matériel..."
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-font-size: 14px;
                         -fx-padding: 10 20;
                         -fx-prompt-text-fill: #95a5a6;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                  prefWidth="200"/>

        <TextField fx:id="filterUserField" promptText="Filtrer par utilisateur..."
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-font-size: 14px;
                         -fx-padding: 10 20;
                         -fx-prompt-text-fill: #95a5a6;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                  prefWidth="200"/>
    </HBox>

    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;
                      -fx-background-radius: 15;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">
        <columns>
            <TableColumn fx:id="userColumn" text="Utilisateur" prefWidth="120"
                        style="-fx-alignment: CENTER-LEFT; -fx-font-size: 13px;"/>
            <TableColumn fx:id="evenementIdColumn" text="Événement" prefWidth="100"
                        style="-fx-alignment: CENTER-LEFT; -fx-font-size: 13px;"/>
            <TableColumn fx:id="materielIdColumn" text="Matériel" prefWidth="100"
                        style="-fx-alignment: CENTER-LEFT; -fx-font-size: 13px;"/>
            <TableColumn fx:id="quantiteColumn" text="Quantité" prefWidth="80"
                        style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn fx:id="prixTotalColumn" text="Prix Total" prefWidth="100"
                        style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="120"
                        style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn fx:id="dateFinColumn" text="Date Fin" prefWidth="120"
                        style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"
                        style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
        </columns>
    </TableView>

    <stylesheets>
        <URL value="@/stylereservation.css"/>
    </stylesheets>
</VBox>