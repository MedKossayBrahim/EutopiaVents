<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.Ajoutercategorieevent"
            style="-fx-background-color: #faf6f3;">

    <left>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 4, 0);"
              BorderPane.alignment="TOP_LEFT"
              VBox.vgrow="ALWAYS">
            <fx:include source="Navbar.fxml"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="24" style="-fx-padding: 32;">
                <!-- Header Section -->
                <VBox spacing="8">
                    <Text text="Gestion des Catégories"
                          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
                    <Text text="Gérez vos catégories d'événements facilement"
                          style="-fx-font-size: 16px; -fx-fill: #6c757d;"/>
                </VBox>

                <!-- Navigation Bar -->

                <HBox spacing="12" style="-fx-padding: 16; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                    <Button fx:id="btnAjouterCateg" text="Ajouter Catégorie" onAction="#goToAjouterCateg"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                    <Button fx:id="btnAjouterEvenement" text="Ajouter Événement" onAction="#goToAjouterEvenement"
                            style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                    <Button fx:id="btnModifierEvenement" text="Modifier Événement" onAction="#goToModifierEvenement"
                            style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                    <Button fx:id="btnGererEvenements" text="Gérer Événements" onAction="#goToGererEvenements"
                            style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                </HBox>

                <!-- Main Content -->
                <VBox spacing="24" style="-fx-background-color: white; -fx-padding: 32; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 0);">
                    <!-- Add Category Form -->
                    <VBox spacing="16">
                        <Label text="Nouvelle Catégorie"
                               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <TextField fx:id="categ" promptText="Entrez le nom de la catégorie"
                                       style="-fx-pref-width: 400; -fx-pref-height: 40; -fx-background-radius: 8; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-padding: 8;"/>
                            <Button text="+ Ajouter" onAction="#ajouter"
                                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8;"/>
                        </HBox>
                    </VBox>

                    <!-- Categories Table -->
                    <VBox spacing="16" VBox.vgrow="ALWAYS">
                        <Label text="Liste des Catégories"
                               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <TableView fx:id="categorieTable" VBox.vgrow="ALWAYS"
                                   style="-fx-background-radius: 8; -fx-border-color: #dee2e6; -fx-border-radius: 8;">
                            <columns>
                                <TableColumn fx:id="nomColumn" text="Nom de la catégorie" prefWidth="500"
                                             style="-fx-alignment: CENTER-LEFT; -fx-padding: 10;"/>
                                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200"
                                             style="-fx-alignment: CENTER;"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
