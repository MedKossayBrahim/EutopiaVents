<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.EventsController"
            style="-fx-background-color: white;">

    <left>
        <VBox style="-fx-background-color: #faf6f3; -fx-border-color: transparent #dedad7 transparent transparent; -fx-border-width: 0 1px 0 0;"
              BorderPane.alignment="TOP_LEFT"
              VBox.vgrow="ALWAYS">
            <fx:include source="Navbar.fxml"/>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
            <Label text="Événements à venir"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <!-- Barre de navigation -->
            <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
                <Button text="Ajouter Catégorie" onAction="#goToAjouterCateg"/>
                <Button text="Ajouter Événement" onAction="#goToAjouterEvenement"/>
                <Button text="Modifier Événement" onAction="#goToModifierEvenement"/>
                <Button text="Voir Événements" onAction="#goToEventsView"/>
                <Button text="Gérer Événements" onAction="#goToGererEvenements"/>
            </HBox>

            <!-- Zone principale de défilement -->
            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: transparent;">
                <content>
                    <VBox style="-fx-padding: 20;">
                        <GridPane fx:id="eventsGrid"
                                  hgap="20"
                                  vgap="20"
                                  style="-fx-padding: 10;">
                            <!-- Les événements seront ajoutés ici dynamiquement -->
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                        </GridPane>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
