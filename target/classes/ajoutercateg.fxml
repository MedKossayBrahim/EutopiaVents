<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.Ajoutercateg"
      styleClass="root">

   <padding>
      <Insets top="30" right="40" bottom="30" left="40"/>
   </padding>

   <!-- Titre du formulaire -->
   <Label text="Ajouter une Catégorie" styleClass="title-label"/>

   <!-- Formulaire -->
   <GridPane hgap="10" vgap="10">
      <Label text="Catégorie:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <TextField fx:id="tfcategorie" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>
   </GridPane>

   <!-- Bouton Ajouter -->
   <Button text="Ajouter" onAction="#addcateg" styleClass="success"/>

   <stylesheets>
      <URL value="@/styleall.css"/>
   </stylesheets>
</VBox>