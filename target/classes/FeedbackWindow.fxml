<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" 
            prefWidth="400" prefHeight="500">
    <VBox spacing="10" alignment="CENTER" layoutX="20" layoutY="20" 
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" 
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20">
        
        <Label text="Avis existants :" style="-fx-font-weight: bold"/>
        <ListView fx:id="feedbackListView" VBox.vgrow="ALWAYS" prefHeight="200"/>
        
        <Label text="Votre avis :" style="-fx-font-weight: bold"/>
        <TextArea fx:id="feedbackTextArea" prefHeight="100" wrapText="true" />

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnEnvoyer" text="Envoyer" />
            <Button fx:id="btnAnnuler" text="Annuler" />
        </HBox>
    </VBox>
</AnchorPane>
