<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.EventDetailsController"
      stylesheets="@styles.css"
      spacing="25"
      style="-fx-padding: 30; -fx-background-color: #faf6f3;">

    <!-- Carte principale -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-padding: 20;">
        <!-- Titre de l'événement -->
        <Label fx:id="titreLabel"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 15 0;"
               maxWidth="Infinity"
               alignment="CENTER"/>


        <!-- Informations principales -->
        <HBox spacing="40" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">
            <!-- Lieu -->
            <VBox spacing="8" styleClass="info-box">
                <HBox spacing="10" alignment="CENTER">
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@Images/map.png"/>
                    </ImageView>
                    <Label text="Lieu" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #34495e;"/>
                </HBox>
                <Label fx:id="lieuLabel"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
            </VBox>

            <!-- Date -->
            <VBox spacing="8" styleClass="info-box">
                <HBox spacing="10" alignment="CENTER">
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@Images/calendar.png"/>
                    </ImageView>
                    <Label text="Date" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #34495e;"/>
                </HBox>
                <Label fx:id="dateLabel"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
            </VBox>

            <!-- Horaires -->
            <VBox spacing="8" styleClass="info-box">
                <HBox spacing="10" alignment="CENTER">
                    <ImageView fitHeight="24" fitWidth="24">
                        <Image url="@Images/clock.png"/>
                    </ImageView>
                    <Label text="Horaires" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #34495e;"/>
                </HBox>
                <Label fx:id="timeLabel"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
            </VBox>
        </HBox>
        <!-- Image de l'événement -->
        <StackPane style="-fx-padding: 0 0 20 0;">
            <ImageView fx:id="eventImageView"
                       fitWidth="600"
                       fitHeight="300"
                       preserveRatio="true"
                       style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0); -fx-background-radius: 10;"/>
        </StackPane>

        <!-- Description -->
        <VBox spacing="10" style="-fx-padding: 20 0;">
            <Label text="Description"
                   style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="descriptionLabel"
                   wrapText="true"
                   style="-fx-font-size: 14; -fx-text-fill: #7f8c8d; -fx-line-spacing: 1.4;"/>
        </VBox>
    </VBox>

    <!-- Bouton de réservation -->
    <HBox alignment="CENTER">
        <Button fx:id="reserverButton"
                onAction="#reserverEvenement"
                style="-fx-background-color: #2ecc71;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-font-size: 14;
                       -fx-padding: 15 40;
                       -fx-background-radius: 25;
                       -fx-effect: dropshadow(three-pass-box, rgba(46,204,113,0.4), 10, 0, 0, 0);
                       -fx-cursor: hand;">
            <HBox.margin>
                <Insets top="10"/>
            </HBox.margin>
        </Button>
    </HBox>
</VBox>
