<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.EventDetailsController"
      spacing="20">

    <ImageView fx:id="eventImageView"
               fitWidth="400"
               fitHeight="250"
               preserveRatio="true"/>

    <VBox spacing="15">
        <Label fx:id="titreLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <Label fx:id="descriptionLabel" style="-fx-font-size: 14px;"/>

        <HBox spacing="10">
            <ImageView fx:id="iconMap"
                       fitWidth="24"
                       fitHeight="24"/>
            <VBox spacing="5">
                <Label text="Lieu" style="-fx-font-weight: bold;"/>
                <Label fx:id="lieuLabel"/>
                <Label fx:id="lieuInfoLabel"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <ImageView fx:id="iconDate"
                       fitWidth="24"
                       fitHeight="24"/>
            <VBox spacing="5">
                <Label text="Date" style="-fx-font-weight: bold;"/>
                <Label fx:id="dateLabel"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <ImageView fx:id="iconTime"
                       fitWidth="24"
                       fitHeight="24"/>
            <VBox spacing="5">
                <Label text="Horaires" style="-fx-font-weight: bold;"/>
                <Label fx:id="timeLabel"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <ImageView fx:id="iconClock"
                       fitWidth="24"
                       fitHeight="24"/>
            <VBox spacing="5">
                <Label text="Durée" style="-fx-font-weight: bold;"/>
                <Label fx:id="heureLabel"/>
            </VBox>
        </HBox>
    </VBox>

    <Button fx:id="reserverButton" onAction="#reserverEvenement" styleClass="confirm-button" />



</VBox>
