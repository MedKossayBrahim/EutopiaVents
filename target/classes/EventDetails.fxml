<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.EventDetailsController"
      stylesheets="@styles.css"
      spacing="20"
      style="-fx-padding: 20; -fx-background-color: -main-bg;">

    <!-- Titre de l'événement -->
    <Label fx:id="titreLabel" 
           styleClass="title-label" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-alignment: center;"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <!-- Lieu, Date, Horaires alignés horizontalement -->
    <HBox spacing="40" alignment="CENTER_LEFT">
        <!-- Lieu avec icône -->
        <VBox spacing="5">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ImageView fitHeight="16" fitWidth="16">
                    <Image url="@Images/map.png"/>
                </ImageView>
                <Label text="Lieu" style="-fx-font-weight: bold; -fx-text-fill: -text;"/>
            </HBox>
            <Label fx:id="lieuLabel" style="-fx-text-fill: -text; -fx-padding: 0 0 0 24;"/>
        </VBox>

        <!-- Date avec icône -->
        <VBox spacing="5">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ImageView fitHeight="16" fitWidth="16">
                    <Image url="@Images/calendar.png"/>
                </ImageView>
                <Label text="Date" style="-fx-font-weight: bold; -fx-text-fill: -text;"/>
            </HBox>
            <Label fx:id="dateLabel" style="-fx-text-fill: -text; -fx-padding: 0 0 0 24;"/>
        </VBox>

        <!-- Horaires avec icône -->
        <VBox spacing="5">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ImageView fitHeight="16" fitWidth="16">
                    <Image url="@Images/clock.png"/>
                </ImageView>
                <Label text="Horaires" style="-fx-font-weight: bold; -fx-text-fill: -text;"/>
            </HBox>
            <Label fx:id="timeLabel" style="-fx-text-fill: -text; -fx-padding: 0 0 0 24;"/>
        </VBox>
    </HBox>

    <!-- Image de l'événement -->
    <StackPane>
        <ImageView fx:id="eventImageView"
                   fitWidth="400"
                   fitHeight="250"
                   preserveRatio="true"
                   styleClass="card"/>
    </StackPane>

    <!-- Description de l'événement -->
    <Label fx:id="descriptionLabel" style="-fx-font-size: 14px; -fx-text-fill: -text;"/>

    <!-- Durée -->


    <!-- Bouton de réservation -->
    <Button fx:id="reserverButton"
            onAction="#reserverEvenement"
            text="Réserver"
            styleClass="confirm-button"/>
</VBox>
