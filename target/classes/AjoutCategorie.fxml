<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.AjouterCategorie"
            stylesheets="@styles/categories.css">
    <children>
        <VBox spacing="20" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <!-- En-tête -->
            <HBox styleClass="header-container" alignment="CENTER">
                <Label styleClass="main-title" text="Gestion des Catégories"/>
            </HBox>

            <!-- Contenu principal -->
            <SplitPane dividerPositions="0.4" VBox.vgrow="ALWAYS">
                <!-- Panneau gauche : Formulaire d'ajout -->
                <VBox spacing="15" styleClass="form-container">
                    <Label styleClass="section-title" text="Nouvelle Catégorie"/>

                    <VBox spacing="10">
                        <Label text="Nom"/>
                        <TextField fx:id="tfNom" promptText="Entrez le nom de la catégorie"/>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="Description"/>
                        <TextField fx:id="tfDescription" promptText="Entrez la description"/>
                    </VBox>

                    <Button styleClass="button-primary" onAction="#addCategorie" text="Ajouter"/>

                    <Label styleClass="info-label" text="* Double-cliquez sur une catégorie pour la modifier ou la supprimer"
                           wrapText="true"/>
                </VBox>

                <!-- Panneau droit : Liste des catégories -->
                <VBox spacing="15" styleClass="list-container">
                    <Label styleClass="section-title" text="Liste des Catégories"/>

                    <TableView fx:id="categoriesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="150"/>
                            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune catégorie disponible"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </SplitPane>
        </VBox>
    </children>
</AnchorPane>