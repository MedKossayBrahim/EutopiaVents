<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.Listeproduit"
      styleClass="main-container"
      spacing="10">

    <!-- En-tête avec recherche et filtres -->
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="15" right="20" bottom="15" left="20"/>
        </padding>

        <VBox>
            <Label text="Liste des Produits" styleClass="title"/>
            <Label text="Gérez votre catalogue de produits" styleClass="subtitle"/>
        </VBox>

        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="10">
            <TextField fx:id="searchField" promptText="Rechercher un produit..." styleClass="search-input"/>
            <ComboBox fx:id="priceFilter" promptText="Filtrer par prix"/>
            <Button fx:id="ajouterAuPanierBtn" text="Ajouter au Panier" styleClass="primary-button"/>
        </HBox>
    </HBox>

    <!-- Contenu scrollable -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="content-area">
        <VBox spacing="15" alignment="CENTER">
            <GridPane fx:id="produitsGrid"
                      vgap="15"
                      hgap="15"
                      alignment="CENTER"
                      styleClass="produits-grid">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
            </GridPane>

            <Pagination fx:id="pagination"
                        styleClass="custom-pagination"
                        maxPageIndicatorCount="5"/>
        </VBox>
    </ScrollPane>

</VBox>