<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.Listeproduit"
      styleClass="main-container"
      stylesheets="@styles/listeproduit.css">
    <!-- Include Navbar -->
    <fx:include source="Navbar.fxml"/>

    <!-- Main Content -->
    <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff;">
        <!-- En-tête -->
        <HBox styleClass="header-container" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label styleClass="main-title" text="Gestion des Produits"/>
        </HBox>

        <!-- Barre de recherche et filtres -->
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 20;">
            <TextField fx:id="searchField" promptText="Rechercher un produit..." 
                      styleClass="search-field"
                      prefWidth="300"/>
            <ComboBox fx:id="priceFilter" promptText="Filtrer par prix"
                     styleClass="combo-box"/>
            <Button fx:id="ajouterAuPanierBtn" text="Ajouter au Panier" 
                    styleClass="button-primary"/>
        </HBox>

        <!-- Contenu scrollable -->
        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="content-area"
                   style="-fx-background-color: transparent;">
            <VBox spacing="15" alignment="CENTER">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <GridPane fx:id="produitsGrid"
                         vgap="20"
                         hgap="20"
                         alignment="CENTER"
                         styleClass="produits-grid">
                </GridPane>

                <Pagination fx:id="pagination"
                           styleClass="custom-pagination"
                           maxPageIndicatorCount="5"/>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>