<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.MainController"
            style="-fx-background-color: #f4f4f4;"
            fx:id="rootPane">

    <!-- Barre de navigation à gauche -->
    <left>
        <VBox style="-fx-background-color: #faf6f3;
                     -fx-border-color: transparent #dedad7 transparent transparent;
                     -fx-border-width: 0 1px 0 0;"
              BorderPane.alignment="TOP_LEFT"
              VBox.vgrow="ALWAYS"
              prefHeight="${rootPane.height}">
            <fx:include source="Navbar.fxml"/>
        </VBox>
    </left>

    <!-- Contenu principal centré -->
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 30px;">
            <Label text="Gestion des Matériels, Catégories et Réservations"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <!-- Gestion des Matériels -->
            <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20;">
                <Label text="Gestion des Matériels" style="-fx-font-size: 18px;"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Ajouter un Matériel"
                            onAction="#openAjoutMateriel"
                            style="-fx-min-width: 150px;"/>
                    <Button text="Liste des Matériels"
                            onAction="#openListeMateriel"
                            style="-fx-min-width: 150px;"/>
                </HBox>
            </VBox>

            <!-- Gestion des Catégories -->
            <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20;">
                <Label text="Gestion des Catégories" style="-fx-font-size: 18px;"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Ajouter une Catégorie"
                            onAction="#openAjoutCategorie"
                            style="-fx-min-width: 150px;"/>
                    <Button text="Liste des Catégories"
                            onAction="#openListeCategorie"
                            style="-fx-min-width: 150px;"/>
                </HBox>
            </VBox>

            <!-- Gestion des Réservations -->
            <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20;">
                <Label text="Gestion des Réservations" style="-fx-font-size: 18px;"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Liste des Réservations"
                            onAction="#openListeReservation"
                            style="-fx-min-width: 150px;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
