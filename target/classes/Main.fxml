<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.MainController"
      style="-fx-background-color: #eef1f6; -fx-padding: 40px;">

    <Label text="Gestion des Matériels, Catégories et Réservations"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label text="Gestion des Matériels" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <HBox spacing="15" alignment="CENTER">
            <Button text="Ajouter un Matériel"
                    onAction="#openAjoutMateriel"
                    style="-fx-min-width: 160px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;"/>
            <Button text="Liste des Matériels"
                    onAction="#openListeMateriel"
                    style="-fx-min-width: 160px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;"/>
        </HBox>
    </VBox>

    <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label text="Gestion des Catégories" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <HBox spacing="15" alignment="CENTER">
            <Button text="Ajouter une Catégorie"
                    onAction="#openAjoutCategorie"
                    style="-fx-min-width: 160px; -fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;"/>
            <Button text="Liste des Catégories"
                    onAction="#openListeCategorie"
                    style="-fx-min-width: 160px; -fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;"/>
        </HBox>
    </VBox>

    <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label text="Gestion des Réservations" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <HBox spacing="15" alignment="CENTER">
            <Button text="Liste des Réservations"
                    onAction="#openListeReservation"
                    style="-fx-min-width: 160px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;"/>
        </HBox>
    </VBox>
</VBox>