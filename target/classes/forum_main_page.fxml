<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.ForumMainController"
            fx:id="rootPane">
    <left>
        <VBox style="-fx-background-color: #faf6f3; -fx-border-color: transparent #dedad7 transparent transparent; -fx-border-width: 0 1px 0 0;"
              BorderPane.alignment="TOP_LEFT"
              VBox.vgrow="ALWAYS"
              prefHeight="${rootPane.height}">
        </VBox>
    </left>

    <right>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: transparent;
                          -fx-background-color: #faf6f3;
                          -fx-background-insets: 0;
                          -fx-padding: 0;">
            <VBox spacing="20" style="-fx-background-color: #faf6f3;">
                <!-- Calendar first -->
                <VBox fx:id="calendarContainer"
                      VBox.vgrow="NEVER"
                      style="-fx-background-color: #faf6f3;
                             -fx-background-radius: 15;
                             -fx-padding: 15;"/>

                <!-- Chat below calendar -->
                <VBox fx:id="chatArea"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #faf6f3;
                             -fx-background-radius: 15;
                             -fx-padding: 15;">
                    <!-- Chat content here -->
                </VBox>
            </VBox>

            <style>
                /* Hide scrollbars */
                .scroll-pane .scroll-bar:vertical {
                -fx-scale-x: 0;
                }
                .scroll-pane .scroll-bar:horizontal {
                -fx-scale-y: 0;
                }
                .scroll-pane {
                -fx-background-color: transparent;
                }
                .scroll-pane .viewport {
                -fx-background-color: transparent;
                }
                .scroll-pane .content {
                -fx-background-color: transparent;
                }
            </style>
        </ScrollPane>
    </right>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #faf6f3; -fx-background-color: #faf6f3;
                          -fx-background-insets: 0;
                          -fx-padding: 0;"
                    vbarPolicy="AS_NEEDED"
                    hbarPolicy="NEVER">
            <VBox spacing="20" style="-fx-background-color: #faf6f3;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <HBox spacing="15" alignment="CENTER">
                    <HBox spacing="10" alignment="CENTER" maxWidth="500" HBox.hgrow="ALWAYS"
                          fx:id="searchContainer"
                          style="-fx-background-color: #f0eae4; -fx-background-radius: 25;
                                 -fx-padding: 12 25; -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.2), 5, 0, 0, 2);
                                 -fx-border-color: rgba(245,148,92,0.1); -fx-border-radius: 25; -fx-border-width: 1;">
                        <ComboBox fx:id="searchFilterComboBox"
                                  promptText="Filter by"
                                  style="-fx-background-color: transparent;
                                       -fx-font-size: 14;
                                       -fx-border-color: transparent;
                                       -fx-font-family: 'Segoe UI';">
                        </ComboBox>
                        <ImageView fitHeight="18" fitWidth="18" onMouseClicked="#activateSearch"
                                   style="-fx-cursor: hand; -fx-opacity: 0.7;">
                            <Image url="@Images/search_icon.jpg"/>
                        </ImageView>
                        <TextField fx:id="searchField"
                                   promptText="Search Posts..."
                                   onKeyReleased="#onSearchKeyReleased"
                                   focusTraversable="false"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: transparent;
                                          -fx-font-size: 14;
                                          -fx-padding: 0;
                                          -fx-background-radius: 25;
                                          -fx-font-family: 'Segoe UI';
                                          -fx-prompt-text-fill: #888888;"/>
                    </HBox>
                </HBox>

                <HBox spacing="15" HBox.hgrow="ALWAYS">
                    <HBox spacing="20" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: linear-gradient(to right, #f0eae4, #f5e6d3);
                                 -fx-background-radius: 15; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.25), 8, 0, 0, 3);
                                 -fx-border-color: rgba(245,148,92,0.1);
                                 -fx-border-radius: 15;
                                 -fx-border-width: 1;">
                        <ImageView fitHeight="80" fitWidth="80">
                            <Image url="@Images/eutopia1_logo.png"/>
                        </ImageView>
                        <VBox spacing="8">
                            <Label fx:id="welcomeUsernameLabel" text="Hi, Username_here" 
                                   style="-fx-font-size: 16px; -fx-text-fill: #2D3250; -fx-font-family: 'Segoe UI';"/>
                            <Label text="Welcome to the Blog" 
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f5945c; -fx-font-family: 'Segoe UI';"/>
                            <Label text="Offers, demands and updates are gonna be here."
                                   style="-fx-font-size: 14px; -fx-text-fill: #666666; -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="addButton" text="Add Post" onAction="#onAddPostClick"
                                style="-fx-background-color: linear-gradient(to right, #f5945c, #f0ad4e);
                                       -fx-text-fill: white;
                                       -fx-background-radius: 20;
                                       -fx-padding: 12 30;
                                       -fx-font-size: 14;
                                       -fx-cursor: hand;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Segoe UI';
                                       -fx-effect: dropshadow(gaussian, rgba(245,148,92,0.4), 6, 0, 0, 2);"/>
                    </HBox>
                </HBox>

                <VBox spacing="20" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Latest Updates"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2D3250; -fx-font-family: 'Segoe UI';">
                            <VBox.margin>
                                <Insets left="20"/>
                            </VBox.margin>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="viewAllUpdatesButton" text="View All"
                                onAction="#onViewAllUpdatesClick"
                                style="-fx-background-color: rgba(245,148,92,0.1);
                                       -fx-text-fill: #f5945c;
                                       -fx-font-size: 13;
                                       -fx-cursor: hand;
                                       -fx-border-color: rgba(245,148,92,0.2);
                                       -fx-border-radius: 20;
                                       -fx-background-radius: 20;
                                       -fx-padding: 8 20;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Segoe UI';">
                            <HBox.margin>
                                <Insets right="20"/>
                            </HBox.margin>
                        </Button>
                    </HBox>

                    <ListView fx:id="latestUpdatesList"
                              maxHeight="300"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 20;
                                     -fx-border-radius: 20;
                                     -fx-border-color: rgba(245,148,92,0.1);
                                     -fx-padding: 10;
                                     -fx-background-insets: 0;
                                     -fx-fixed-cell-size: 140;
                                     -fx-selection-bar: transparent;
                                     -fx-selection-bar-non-focused: transparent;
                                     -fx-background: transparent;
                                     -fx-control-inner-background: transparent;
                                     -fx-focus-color: transparent;
                                     -fx-faint-focus-color: transparent;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <VBox.margin>
                            <Insets left="20" right="20"/>
                        </VBox.margin>
                    </ListView>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Pinned Posts"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2D3250; -fx-font-family: 'Segoe UI';">
                            <VBox.margin>
                                <Insets left="20"/>
                            </VBox.margin>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="viewAllPinnedButton" text="View All"
                                onAction="#onViewAllPinnedClick"
                                style="-fx-background-color: rgba(245,148,92,0.1);
                                       -fx-text-fill: #f5945c;
                                       -fx-font-size: 13;
                                       -fx-cursor: hand;
                                       -fx-border-color: rgba(245,148,92,0.2);
                                       -fx-border-radius: 20;
                                       -fx-background-radius: 20;
                                       -fx-padding: 8 20;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Segoe UI';">
                            <HBox.margin>
                                <Insets right="20"/>
                            </HBox.margin>
                        </Button>
                    </HBox>

                    <ListView fx:id="pinnedPostsList"
                              maxHeight="300"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 20;
                                     -fx-border-radius: 20;
                                     -fx-border-color: rgba(245,148,92,0.1);
                                     -fx-padding: 10;
                                     -fx-background-insets: 0;
                                     -fx-fixed-cell-size: 140;
                                     -fx-selection-bar: transparent;
                                     -fx-selection-bar-non-focused: transparent;
                                     -fx-background: transparent;
                                     -fx-control-inner-background: transparent;
                                     -fx-focus-color: transparent;
                                     -fx-faint-focus-color: transparent;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <VBox.margin>
                            <Insets left="20" right="20" bottom="20"/>
                        </VBox.margin>
                    </ListView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>